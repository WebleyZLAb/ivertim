# Resend (https://resend.com) API key used by src/lib/email.ts for the contact form.
RESEND_API_KEY=

# Destination inbox for contact form submissions.
CONTACT_EMAIL_TO=

# Verified sender address/domain in Resend. Must be a domain you've verified
# with Resend — placeholder until the real business domain is confirmed.
CONTACT_EMAIL_FROM=

# The footer newsletter signup (src/pages/api/newsletter.ts) reuses
# RESEND_API_KEY above — no separate env var needed. Resend's Contacts API
# is global (no Audience/audienceId required to create a contact); see
# src/lib/email.ts's subscribeToNewsletter for the full explanation.
