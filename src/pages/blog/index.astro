---
// Structure and copy follow docs/04 - Copywriting/Advice-Blueprint-v1.0.md (Approved, v1.0) verbatim
// where final copy exists. §10 asks for 3-4 "izdvojena" (featured) cards — entries flagged
// `featured: true` win, topped up with the most recent otherwise, capped at 4.
import { getCollection } from "astro:content";
import PageLayout from "../../layouts/PageLayout.astro";
import { BLOG_TOPICS, blogTopicLabel, estimateReadingMinutes } from "../../lib/blog";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);

const featuredPosts = posts.filter((post) => post.data.featured);
const highlighted = (featuredPosts.length > 0 ? featuredPosts : posts).slice(0, 4);
---

<PageLayout
  title="Blog / Savjeti"
  description="Znanje koje pomaže prije nego što donesete odluku — o planiranju prostora, materijalima i procesu izrade."
>
  <section class="section hero" aria-labelledby="hero-heading" data-reveal>
    <h1 id="hero-heading">Znanje koje pomaže prije nego što donesete odluku.</h1>
    <p class="lead">
      Uređenje prostora podrazumijeva mnogo pitanja i odluka. Ovdje dijelimo iskustva, praktične savjete i odgovore koji će vam pomoći da bolje razumijete mogućnosti prije nego što projekat počne.
    </p>
    <a class="cta" href="#savjeti">Istražite savjete</a>
  </section>

  <section class="section" aria-labelledby="zasto-heading" data-reveal>
    <h2 id="zasto-heading">Dobar projekat počinje dobrim informacijama.</h2>
    <p class="section-lead">
      Vjerujemo da je lakše donijeti pravu odluku kada razumijete mogućnosti koje imate. Zato ovdje pišemo o planiranju prostora, materijalima, organizaciji i iskustvima iz stvarnih projekata.
    </p>
  </section>

  <section class="section" id="savjeti" aria-labelledby="savjeti-heading" data-reveal>
    <h2 id="savjeti-heading">Istaknuti savjeti</h2>
    {
      highlighted.length === 0 ? (
        <p class="empty">Prvi članci stižu uskoro.</p>
      ) : (
        <ul class="post-list">
          {highlighted.map((post) => {
            const topic = blogTopicLabel(post.data.topic);
            const minutes = estimateReadingMinutes(post.body);
            return (
              <li class="post-card">
                {topic && <p class="eyebrow">{topic}</p>}
                <a class="post-title" href={`/blog/${post.id}`}>
                  {post.data.title}
                </a>
                <p class="post-description">{post.data.description}</p>
                <p class="post-meta">{minutes} min čitanja</p>
              </li>
            );
          })}
        </ul>
      )
    }
  </section>

  <section class="section" aria-labelledby="kategorije-heading" data-reveal>
    <h2 id="kategorije-heading">Kategorije</h2>
    <ul class="topic-list">
      {BLOG_TOPICS.map((topic) => (
        <li class="topic-chip">{topic.label}</li>
      ))}
    </ul>
  </section>

  <section class="section closing" aria-labelledby="closing-heading" data-reveal>
    <h2 id="closing-heading">Imate pitanje koje ovdje niste pronašli?</h2>
    <p class="section-lead">
      Svaki prostor je drugačiji. Ako želite razgovarati o svom konkretnom projektu, tu smo da zajedno pronađemo najbolje rješenje.
    </p>
    <a class="cta" href="/kontakt">Razgovarajmo</a>
  </section>
</PageLayout>

<style>
  .section {
    padding-top: var(--space-3xl);
    padding-bottom: var(--space-3xl);
    border-top: var(--border-1) solid var(--border-subtle);
  }

  .hero {
    padding-top: 0;
    border-top: none;
  }

  h1 {
    font-size: var(--text-h1-size-fluid);
    line-height: var(--text-h1-leading);
    font-weight: var(--text-h1-weight);
    letter-spacing: var(--text-h1-tracking);
    max-width: var(--content-max);
  }

  .lead {
    margin-top: var(--space-lg);
    max-width: var(--content-max);
    font-size: var(--text-body-lg-size);
    line-height: var(--text-body-lg-leading);
    color: var(--text-secondary);
  }

  .hero .cta {
    margin-top: var(--space-xl);
  }

  h2 {
    font-size: var(--text-h2-size-fluid);
    line-height: var(--text-h2-leading);
    font-weight: var(--text-h2-weight);
    letter-spacing: var(--text-h2-tracking);
    max-width: var(--content-max);
  }

  .section-lead {
    margin-top: var(--space-md);
    max-width: var(--content-max);
    font-size: var(--text-body-lg-size);
    line-height: var(--text-body-lg-leading);
    color: var(--text-secondary);
  }

  .empty {
    margin-top: var(--space-xl);
    color: var(--text-tertiary);
  }

  .post-list {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-lg);
    margin-top: var(--space-xl);
  }

  .post-card {
    padding: var(--space-xl);
    background: var(--surface-1);
    border: var(--border-1) solid var(--border-subtle);
    border-radius: var(--radius-3);
  }

  .eyebrow {
    font-size: var(--text-overline-size);
    font-weight: var(--text-overline-weight);
    letter-spacing: var(--text-overline-tracking);
    text-transform: uppercase;
    color: var(--text-accent);
    margin-bottom: var(--space-xs);
  }

  .post-title {
    display: block;
    font-size: var(--text-h4-size);
    line-height: var(--text-h4-leading);
    font-weight: var(--text-h4-weight);
    color: var(--text-primary);
    text-decoration: none;
  }

  .post-title:hover {
    color: var(--text-accent);
  }

  .post-description {
    margin-top: var(--space-sm);
    color: var(--text-secondary);
  }

  .post-meta {
    margin-top: var(--space-md);
    font-size: var(--text-body-sm-size);
    color: var(--text-tertiary);
  }

  .topic-list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-top: var(--space-xl);
  }

  .topic-chip {
    padding: var(--space-xs) var(--space-lg);
    border: var(--border-1) solid var(--border-subtle);
    border-radius: var(--radius-full, 999px);
    font-size: var(--text-label-md-size);
    font-weight: var(--text-label-md-weight);
    color: var(--text-secondary);
  }

  .cta {
    display: inline-flex;
    padding: var(--space-sm) var(--space-xl);
    background: var(--action-primary);
    color: var(--action-primary-text);
    border-radius: var(--radius-2);
    text-decoration: none;
    font-weight: var(--text-label-lg-weight);
  }

  .cta:hover {
    background: var(--action-primary-hover);
  }

  .closing .cta {
    margin-top: var(--space-xl);
  }

  @media (min-width: 768px) {
    .post-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
