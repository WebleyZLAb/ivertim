---
// Article template per docs/04 - Copywriting/Advice-Template-Blueprint-v1.0.md (Approved, v1.0).
// The closing CTA (§13) is identical, fixed copy on every article, so it's hardcoded in this
// template rather than authored per post — see the <section class="closing"> block below.
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import PageLayout from "../../layouts/PageLayout.astro";
import { blogTopicLabel, estimateReadingMinutes } from "../../lib/blog";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const topic = blogTopicLabel(post.data.topic);
const minutes = estimateReadingMinutes(post.body);
---

<PageLayout title={post.data.title} description={post.data.description}>
  <article data-reveal>
    <header class="hero">
      <p class="meta">
        {minutes} min čitanja{topic && <> · {topic}</>}
      </p>
      <h1>{post.data.title}</h1>
      <p class="lead">{post.data.description}</p>
      {
        post.data.heroImage && (
          <Image class="hero-image" src={post.data.heroImage} alt="" width={1200} height={675} />
        )
      }
    </header>

    <div class="prose">
      <Content />
    </div>

    <section class="closing" aria-labelledby="closing-heading">
      <h2 id="closing-heading">Svaki prostor ima svoje specifičnosti.</h2>
      <p>
        Savjeti mogu pomoći da bolje razumijete mogućnosti, ali nijedan članak ne može zamijeniti razgovor o konkretnom prostoru.
      </p>
      <a class="cta" href="/kontakt">Razgovarajmo</a>
    </section>
  </article>
</PageLayout>

<style>
  article {
    max-width: var(--content-max);
  }

  .meta {
    font-size: var(--text-overline-size);
    font-weight: var(--text-overline-weight);
    letter-spacing: var(--text-overline-tracking);
    text-transform: uppercase;
    color: var(--text-accent);
  }

  h1 {
    margin-top: var(--space-sm);
    font-size: var(--text-h1-size-fluid);
    line-height: var(--text-h1-leading);
    font-weight: var(--text-h1-weight);
    letter-spacing: var(--text-h1-tracking);
  }

  .lead {
    margin-top: var(--space-lg);
    font-size: var(--text-body-lg-size);
    line-height: var(--text-body-lg-leading);
    color: var(--text-secondary);
  }

  .hero-image {
    margin-top: var(--space-xl);
    width: 100%;
    height: auto;
    border-radius: var(--radius-3);
  }

  .prose :global(h2) {
    margin-top: var(--space-3xl);
    font-size: var(--text-h3-size-fluid);
    line-height: var(--text-h3-leading);
    font-weight: var(--text-h3-weight);
    letter-spacing: var(--text-h3-tracking);
  }

  .prose :global(h3) {
    margin-top: var(--space-2xl);
    font-size: var(--text-h5-size);
    line-height: var(--text-h5-leading);
    font-weight: var(--text-h5-weight);
  }

  .prose :global(p) {
    margin-top: var(--space-md);
    font-size: var(--text-body-lg-size);
    line-height: var(--text-body-lg-leading);
    color: var(--text-secondary);
  }

  .prose :global(p:first-of-type) {
    margin-top: var(--space-lg);
  }

  .prose :global(ul),
  .prose :global(ol) {
    margin-top: var(--space-md);
    padding-left: var(--space-lg);
    display: grid;
    gap: var(--space-xs);
    color: var(--text-secondary);
    font-size: var(--text-body-md-size);
    line-height: var(--text-body-md-leading);
  }

  .prose :global(strong) {
    color: var(--text-primary);
  }

  .prose :global(a) {
    font-weight: var(--text-label-md-weight);
  }

  .prose :global(a:hover) {
    text-decoration: underline;
  }

  .closing {
    margin-top: var(--space-4xl);
    padding-top: var(--space-2xl);
    border-top: var(--border-1) solid var(--border-subtle);
  }

  .closing h2 {
    font-size: var(--text-h3-size-fluid);
    line-height: var(--text-h3-leading);
    font-weight: var(--text-h3-weight);
    max-width: var(--content-max);
  }

  .closing p {
    margin-top: var(--space-md);
    max-width: var(--content-max);
    color: var(--text-secondary);
  }

  /* Rounded-rectangle "mark" treatment — see Header.astro's .cta for the
     full rationale (2026-09-05, owner-specified: echo the logo mark). */
  .cta {
    position: relative;
    z-index: 0;
    overflow: hidden;
    display: inline-flex;
    margin-top: var(--space-lg);
    padding: var(--space-sm) calc(var(--space-xl) * 2);
    color: var(--action-primary-text);
    border-radius: var(--radius-2);
    box-shadow: var(--shadow-1);
    text-decoration: none;
    font-weight: var(--text-label-lg-weight);
    transition: transform var(--motion-fast) var(--ease-out), box-shadow var(--motion-fast) var(--ease-out);
  }

  /* Signature Shape as a genuine cutout — see Header.astro's .cta::before
     for the full rationale (2026-09-05, owner-specified): it mirrors how
     the shape works inside the logo mark itself (negative space, not an
     inked overlay), via a two-mask XOR trick that cuts a shape-sized
     hole through this ::before's own fill, revealing whatever's actually
     behind the button. */
  .cta::before {
    content: "";
    position: absolute;
    z-index: -1;
    inset: 0;
    border-radius: inherit;
    background: var(--gradient-button);
    transition: background var(--motion-fast) var(--ease-out);
    -webkit-mask-image: linear-gradient(#000 0 0), url("/images/signature-shape.svg");
    -webkit-mask-repeat: no-repeat, no-repeat;
    -webkit-mask-position: 0 0, left bottom;
    -webkit-mask-size: 100% 100%, auto 62%;
    -webkit-mask-composite: xor;
    mask-image: linear-gradient(#000 0 0), url("/images/signature-shape.svg");
    mask-repeat: no-repeat, no-repeat;
    mask-position: 0 0, left bottom;
    mask-size: 100% 100%, auto 62%;
    mask-composite: exclude;
  }

  .cta:hover::before {
    background: var(--gradient-button-hover);
  }

  .cta:active::before {
    background: var(--gradient-button-active);
  }

  /* Lift on hover, press back down on active — a neutral (uncolored)
     shadow step-up + a small upward nudge, not a color change, so it
     reads clearly without touching the locked no-colored-shadows rule.
     Same treatment on .cta-secondary for consistency (2026-09-05,
     owner-specified). */
  .cta:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-2);
  }

  .cta:active {
    transform: translateY(0);
    box-shadow: var(--shadow-1);
  }
</style>
