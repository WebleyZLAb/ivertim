---
import { getCollection, render } from "astro:content";
import PageLayout from "../../layouts/PageLayout.astro";

export async function getStaticPaths() {
  const usluge = await getCollection("usluge");
  return usluge.map((usluga) => ({
    params: { slug: usluga.id },
    props: { usluga },
  }));
}

const { usluga } = Astro.props;
const { Content } = await render(usluga);
---

<PageLayout title={usluga.data.title} description={usluga.data.description}>
  <article class="prose" data-reveal>
    <h1>{usluga.data.title}</h1>
    <Content />
  </article>
</PageLayout>

<style>
  h1 {
    font-size: var(--text-h1-size-fluid);
    line-height: var(--text-h1-leading);
    font-weight: var(--text-h1-weight);
    letter-spacing: var(--text-h1-tracking);
    max-width: var(--content-max);
  }

  /* No max-width here (was --content-max, 720px) — that width is meant
     for long-form reading (see design-system/layout.md §Content width),
     not for the RoomCategory zigzag sections MDX content renders inside
     .prose, which want the fuller `main` width to give the image panel
     and its text room to breathe. Applied directly to the actual
     long-form elements (h2/h3/p/ul/ol) below instead, so paragraphs stay
     readable while RoomCategory stretches to the full container. */

  .prose :global(h2) {
    max-width: var(--content-max);
    margin-top: var(--space-3xl);
    font-size: var(--text-h3-size-fluid);
    line-height: var(--text-h3-leading);
    font-weight: var(--text-h3-weight);
    letter-spacing: var(--text-h3-tracking);
  }

  .prose :global(h3) {
    max-width: var(--content-max);
    margin-top: var(--space-2xl);
    font-size: var(--text-h5-size);
    line-height: var(--text-h5-leading);
    font-weight: var(--text-h5-weight);
  }

  .prose :global(p) {
    max-width: var(--content-max);
    margin-top: var(--space-md);
    font-size: var(--text-body-lg-size);
    line-height: var(--text-body-lg-leading);
    color: var(--text-secondary);
  }

  .prose :global(p:first-of-type) {
    margin-top: var(--space-lg);
  }

  .prose :global(ul),
  .prose :global(ol) {
    max-width: var(--content-max);
    margin-top: var(--space-md);
    padding-left: var(--space-lg);
    display: grid;
    gap: var(--space-xs);
    color: var(--text-secondary);
    font-size: var(--text-body-md-size);
    line-height: var(--text-body-md-leading);
  }

  .prose :global(strong) {
    color: var(--text-primary);
  }

  .prose :global(a) {
    font-weight: var(--text-label-md-weight);
  }

  .prose :global(a:hover) {
    text-decoration: underline;
  }
</style>
