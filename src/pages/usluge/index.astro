---
import { getCollection } from "astro:content";
import PageLayout from "../../layouts/PageLayout.astro";

const usluge = (await getCollection("usluge")).sort(
  (a, b) => (a.data.order ?? 99) - (b.data.order ?? 99)
);
---

<PageLayout
  title="Usluge"
  description="Dvije usluge, jedan isti pristup preciznosti — uslužno rezanje, kantovanje i bušenje, i izrada namještaja po mjeri."
>
  <section class="hero">
    <h1>Dvije usluge. Jedan isti pristup preciznosti.</h1>
    <p class="lead">
      Bilo da vam treba precizno isječen i okantovan materijal ili kompletan namještaj po mjeri, počinjemo isto — razumijemo šta vam treba, izmjerimo i predložimo rješenje koje odgovara.
    </p>
  </section>

  {
    usluge.length === 0 ? (
      <p>Spisak usluga uskoro stiže.</p>
    ) : (
      <ul class="service-list">
        {usluge.map((usluga, index) => (
          <li>
            <p class="eyebrow">{index === 0 ? "Primarna usluga" : "Sekundarna usluga"}</p>
            <a class="service-title" href={`/usluge/${usluga.id}`}>{usluga.data.title}</a>
            <p class="service-description">{usluga.data.description}</p>
            <span class="service-link">Saznajte više →</span>
          </li>
        ))}
      </ul>
    )
  }

  <section class="closing">
    <h2>Niste sigurni koja usluga odgovara vašem projektu?</h2>
    <p>
      Svaki prostor je drugačiji. Ako niste sigurni odakle krenuti, razgovaraćemo o vašim potrebama i zajedno pronaći najbolje rješenje.
    </p>
    <a class="cta" href="/kontakt">Razgovarajmo</a>
  </section>
</PageLayout>

<style>
  .hero h1 {
    font-size: var(--text-h1-size-fluid);
    line-height: var(--text-h1-leading);
    font-weight: var(--text-h1-weight);
    letter-spacing: var(--text-h1-tracking);
    max-width: var(--content-max);
  }

  .hero .lead {
    margin-top: var(--space-lg);
    max-width: var(--content-max);
    font-size: var(--text-body-lg-size);
    line-height: var(--text-body-lg-leading);
    color: var(--text-secondary);
  }

  .service-list {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-lg);
    margin-top: var(--space-3xl);
  }

  .service-list li {
    padding: var(--space-xl);
    background: var(--surface-1);
    border: var(--border-1) solid var(--border-subtle);
    border-radius: var(--radius-3);
  }

  .eyebrow {
    font-size: var(--text-overline-size);
    font-weight: var(--text-overline-weight);
    letter-spacing: var(--text-overline-tracking);
    text-transform: uppercase;
    color: var(--text-accent);
    margin-bottom: var(--space-sm);
  }

  .service-title {
    display: block;
    font-size: var(--text-h4-size);
    line-height: var(--text-h4-leading);
    font-weight: var(--text-h4-weight);
    color: var(--text-primary);
    text-decoration: none;
  }

  .service-title:hover {
    color: var(--text-accent);
  }

  .service-description {
    margin-top: var(--space-sm);
    color: var(--text-secondary);
    max-width: var(--content-max);
  }

  .service-link {
    display: inline-block;
    margin-top: var(--space-md);
    font-size: var(--text-label-md-size);
    font-weight: var(--text-label-md-weight);
    color: var(--text-accent);
  }

  .closing {
    margin-top: var(--space-4xl);
    padding-top: var(--space-2xl);
    border-top: var(--border-1) solid var(--border-subtle);
  }

  .closing h2 {
    font-size: var(--text-h3-size-fluid);
    line-height: var(--text-h3-leading);
    font-weight: var(--text-h3-weight);
    max-width: var(--content-max);
  }

  .closing p {
    margin-top: var(--space-md);
    max-width: var(--content-max);
    color: var(--text-secondary);
  }

  .cta {
    display: inline-flex;
    margin-top: var(--space-lg);
    padding: var(--space-sm) var(--space-xl);
    background: var(--action-primary);
    color: var(--action-primary-text);
    border-radius: var(--radius-2);
    text-decoration: none;
    font-weight: var(--text-label-lg-weight);
  }

  .cta:hover {
    background: var(--action-primary-hover);
  }
</style>
