---
import { getCollection } from "astro:content";
import PageLayout from "../../layouts/PageLayout.astro";

const usluge = (await getCollection("usluge")).sort(
  (a, b) => (a.data.order ?? 99) - (b.data.order ?? 99)
);
---

<PageLayout
  title="Usluge"
  description="Dvije usluge, jedan isti pristup preciznosti — uslužno rezanje, kantovanje i bušenje, i izrada namještaja po mjeri."
>
  <section class="hero" data-reveal>
    <h1>Dvije usluge. Jedan isti pristup preciznosti.</h1>
    <p class="lead">
      Bilo da vam treba precizno isječen i okantovan materijal ili kompletan namještaj po mjeri, počinjemo isto — razumijemo šta vam treba, izmjerimo i predložimo rješenje koje odgovara.
    </p>
  </section>

  {
    usluge.length === 0 ? (
      <p>Spisak usluga uskoro stiže.</p>
    ) : (
      <ul class="service-list">
        {usluge.map((usluga, index) => (
          <li class:list={["service-card", { "service-card--accent": index === 0 }]} data-reveal>
            <p class="eyebrow">{index === 0 ? "Primarna usluga" : "Sekundarna usluga"}</p>
            <a class="service-title" href={`/usluge/${usluga.id}`}>{usluga.data.title}</a>
            <p class="service-description">{usluga.data.description}</p>
            <span class="service-link">Saznajte više →</span>
          </li>
        ))}
      </ul>
    )
  }

  <section class="closing" data-reveal>
    <h2>Niste sigurni koja usluga odgovara vašem projektu?</h2>
    <p>
      Svaki prostor je drugačiji. Ako niste sigurni odakle krenuti, razgovaraćemo o vašim potrebama i zajedno pronaći najbolje rješenje.
    </p>
    <a class="cta" href="/kontakt">Razgovarajmo</a>
  </section>
</PageLayout>

<style>
  .hero h1 {
    font-size: var(--text-h1-size-fluid);
    line-height: var(--text-h1-leading);
    font-weight: var(--text-h1-weight);
    letter-spacing: var(--text-h1-tracking);
    max-width: var(--content-max);
  }

  .hero .lead {
    margin-top: var(--space-lg);
    max-width: var(--content-max);
    font-size: var(--text-body-lg-size);
    line-height: var(--text-body-lg-leading);
    color: var(--text-secondary);
  }

  .service-list {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-lg);
    margin-top: var(--space-3xl);
  }

  .service-card {
    position: relative;
    overflow: hidden;
    padding: var(--space-xl);
    background: var(--surface-1);
    border: var(--border-1) solid var(--border-subtle);
    border-radius: var(--radius-3);
  }

  /* Bottom-left corner, height pinned to exactly half the card — see
     the matching comment on .usluga-band--accent::after in
     src/pages/index.astro for the full rationale (2026-09-05). Cropping
     the mark to reach the corner further was tried and reverted — it
     turned the recognizable curve into a flat, blocky rectangle, which
     read as worse than the small gap it was meant to fix. Plain
     `contain` keeps the shape looking like itself. */
  .service-card--accent::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: 0;
    top: 50%;
    aspect-ratio: 169.44 / 179.65;
    background: url("/images/signature-shape.svg") no-repeat center / contain;
    opacity: 0.06;
    pointer-events: none;
  }

  .eyebrow {
    font-size: var(--text-overline-size);
    font-weight: var(--text-overline-weight);
    letter-spacing: var(--text-overline-tracking);
    text-transform: uppercase;
    color: var(--text-accent);
    margin-bottom: var(--space-sm);
  }

  .service-title {
    display: block;
    font-size: var(--text-h4-size);
    line-height: var(--text-h4-leading);
    font-weight: var(--text-h4-weight);
    color: var(--text-primary);
    text-decoration: none;
  }

  .service-title:hover {
    color: var(--text-accent);
  }

  .service-description {
    margin-top: var(--space-sm);
    color: var(--text-secondary);
    max-width: var(--content-max);
  }

  .service-link {
    display: inline-block;
    margin-top: var(--space-md);
    font-size: var(--text-label-md-size);
    font-weight: var(--text-label-md-weight);
    color: var(--text-accent);
  }

  .closing {
    margin-top: var(--space-4xl);
    padding-top: var(--space-2xl);
    border-top: var(--border-1) solid var(--border-subtle);
  }

  .closing h2 {
    font-size: var(--text-h3-size-fluid);
    line-height: var(--text-h3-leading);
    font-weight: var(--text-h3-weight);
    max-width: var(--content-max);
  }

  .closing p {
    margin-top: var(--space-md);
    max-width: var(--content-max);
    color: var(--text-secondary);
  }

  /* Rounded-rectangle "mark" treatment — see Header.astro's .cta for the
     full rationale (2026-09-05, owner-specified: echo the logo mark). */
  .cta {
    position: relative;
    z-index: 0;
    overflow: hidden;
    display: inline-flex;
    margin-top: var(--space-lg);
    padding: var(--space-sm) calc(var(--space-xl) * 2);
    color: var(--action-primary-text);
    border-radius: var(--radius-2);
    box-shadow: var(--shadow-1);
    text-decoration: none;
    font-weight: var(--text-label-lg-weight);
    transition: transform var(--motion-fast) var(--ease-out), box-shadow var(--motion-fast) var(--ease-out);
  }

  /* Signature Shape as a genuine cutout — see Header.astro's .cta::before
     for the full rationale (2026-09-05, owner-specified): it mirrors how
     the shape works inside the logo mark itself (negative space, not an
     inked overlay), via a two-mask XOR trick that cuts a shape-sized
     hole through this ::before's own fill, revealing whatever's actually
     behind the button. */
  .cta::before {
    content: "";
    position: absolute;
    z-index: -1;
    inset: 0;
    border-radius: inherit;
    background: var(--gradient-button);
    transition: background var(--motion-fast) var(--ease-out);
    -webkit-mask-image: linear-gradient(#000 0 0), url("/images/signature-shape.svg");
    -webkit-mask-repeat: no-repeat, no-repeat;
    -webkit-mask-position: 0 0, left bottom;
    -webkit-mask-size: 100% 100%, auto 62%;
    -webkit-mask-composite: xor;
    mask-image: linear-gradient(#000 0 0), url("/images/signature-shape.svg");
    mask-repeat: no-repeat, no-repeat;
    mask-position: 0 0, left bottom;
    mask-size: 100% 100%, auto 62%;
    mask-composite: exclude;
  }

  .cta:hover::before {
    background: var(--gradient-button-hover);
  }

  .cta:active::before {
    background: var(--gradient-button-active);
  }

  /* Lift on hover, press back down on active — a neutral (uncolored)
     shadow step-up + a small upward nudge, not a color change, so it
     reads clearly without touching the locked no-colored-shadows rule.
     Same treatment on .cta-secondary for consistency (2026-09-05,
     owner-specified). */
  .cta:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-2);
  }

  .cta:active {
    transform: translateY(0);
    box-shadow: var(--shadow-1);
  }
</style>
