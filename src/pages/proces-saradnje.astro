---
import PageLayout from "../layouts/PageLayout.astro";

const skraceniProces = [
  {
    naziv: "Nacrt ili mjere",
    zasto: "Precizan rezultat počinje tačnim ulaznim podatkom.",
    dobijate: "Sigurnost da će obrada odgovarati vašem nacrtu ili mjerama.",
  },
  {
    naziv: "Potvrda materijala, formata i roka",
    zasto: "Jasan dogovor prije obrade sprječava nesporazume i kašnjenje.",
    dobijate: "Potvrđen materijal, format i rok prije nego što obrada počne.",
  },
  {
    naziv: "Obrada i preuzimanje ili dostava",
    zasto: "Rezultat mora biti gotov za montažu na vašoj strani, bez dodatne dorade.",
    dobijate:
      "Materijal isječen, okantovan i, po potrebi, izbušen prema dogovoru — spreman za preuzimanje ili dostavu.",
  },
];

const sestKoraka = [
  {
    naziv: "Razgovor",
    zasto: "Svaki dobar projekat počinje razumijevanjem ljudi koji će koristiti prostor.",
    dobijate: "Jasno definisane potrebe prije donošenja bilo kakvih odluka.",
  },
  {
    naziv: "Mjerenje",
    zasto: "Dobra rješenja počinju tačnim informacijama.",
    dobijate: "Sigurnost da će svaki element odgovarati stvarnim dimenzijama prostora.",
  },
  {
    naziv: "Prijedlog",
    zasto: "Ideje postaju konkretno rješenje.",
    dobijate: "Jasnu sliku projekta prije početka proizvodnje.",
  },
  {
    naziv: "Potvrda",
    zasto: "Sve važne odluke donosimo prije nego što počne izrada.",
    dobijate: "Manje neizvjesnosti i manje mogućnosti za nesporazume.",
  },
  {
    naziv: "Proizvodnja",
    zasto: "Projekat prelazi iz plana u stvarnost.",
    dobijate: "Izradu prema unaprijed potvrđenom rješenju.",
  },
  {
    naziv: "Montaža",
    zasto: "Posljednji korak nije kraj procesa, već početak korištenja prostora.",
    dobijate: "Prostor spreman za svakodnevni život ili rad.",
  },
];
---

<PageLayout
  title="Proces saradnje"
  description="Kako izgleda saradnja sa Ivertim — za uslužno rezanje i za namještaj po mjeri, korak po korak."
>
  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>

  <section class="hero" data-reveal>
    <h1>Dobar rezultat počinje mnogo prije proizvodnje.</h1>
    <p class="lead">
      Kvalitet namještaja zavisi od mnogo više od same izrade. Zato svaki projekat prolazi kroz jasno definisan proces u kojem svaki korak ima svoju svrhu. Kada je sve dobro isplanirano, rezultat nije samo lijep prostor, već i miran i predvidiv tok cijelog projekta.
    </p>
    <div class="hero-actions">
      <a class="cta" href="/kontakt">Razgovarajmo</a>
      <nav class="quick-nav" aria-label="Skoči na proces">
        <a href="#rezanje">Rezanje →</a>
        <a href="#namjestaj">Namještaj po mjeri →</a>
      </nav>
    </div>
  </section>

  <section class="why" data-reveal>
    <h2>Proces postoji da bi neizvjesnost pretvorio u sigurnost.</h2>
    <div class="why-body">
      <p>Kada uređujete prostor, prirodno je da imate mnogo pitanja.</p>
      <p>Da li će sve odgovarati prostoru?</p>
      <p>Da li će nešto biti zaboravljeno?</p>
      <p>Da li će završni rezultat izgledati onako kako ste zamislili?</p>
      <p>Upravo zato ne preskačemo korake. Svaki od njih postoji kako bi odluke bile donesene na vrijeme, a cijeli projekat tekao jasno i bez nepotrebnih iznenađenja.</p>
    </div>
  </section>

  <section id="rezanje" class="track" data-reveal>
    <p class="eyebrow">Uslužno rezanje, kantovanje i bušenje</p>
    <h2>Kraći proces, bez montaže</h2>
    <div class="story-stack" data-story-stack>
      <div class="story-viewport" data-story-viewport>
        {
          skraceniProces.map((korak, index) => (
            <div class="story-card" data-story-card style={`z-index: ${index + 1}`}>
              <span class="story-number">{String(index + 1).padStart(2, "0")}</span>
              <div>
                <p class="story-name">{korak.naziv}</p>
                <p class="story-label">Zašto postoji</p>
                <p class="story-text">{korak.zasto}</p>
                <p class="story-label">Šta dobijate</p>
                <p class="story-text">{korak.dobijate}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section id="namjestaj" class="track" data-reveal>
    <p class="eyebrow">Izrada namještaja po mjeri</p>
    <h2>Šest koraka</h2>
    <div class="story-stack" data-story-stack>
      <div class="story-viewport" data-story-viewport>
        {
          sestKoraka.map((korak, index) => (
            <div class="story-card" data-story-card style={`z-index: ${index + 1}`}>
              <span class="story-number">{String(index + 1).padStart(2, "0")}</span>
              <div>
                <p class="story-name">{korak.naziv}</p>
                <p class="story-label">Zašto postoji</p>
                <p class="story-text">{korak.zasto}</p>
                <p class="story-label">Šta dobijate</p>
                <p class="story-text">{korak.dobijate}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="meaning" data-reveal>
    <h2>Šta ovakav način rada znači za vas?</h2>
    <div class="meaning-body">
      <p>Jasna očekivanja.</p>
      <p>Bez preskakanja koraka.</p>
      <p>Manje neizvjesnosti.</p>
      <p>Više sigurnosti pri donošenju odluka.</p>
      <p>Prostor koji odgovara onome što je dogovoreno.</p>
      <p>To je razlog zbog kojeg svaki projekat prolazi kroz isti proces.</p>
    </div>
  </section>

  <section class="closing-wrap" data-reveal>
    <div class="closing gradient-brand">
      <h2>Prvi korak je razgovor.</h2>
      <p class="lead closing-lead">
        Svaki projekat počinje razumijevanjem prostora, potreba i očekivanja. Razgovarajmo o tome šta želite da napravite i kojim putem možemo doći do najboljeg rješenja.
      </p>
      <a class="cta cta-on-gradient" href="/kontakt">Razgovarajmo</a>
    </div>
  </section>

  <script>
    function setUpStoryStacks() {
      const g = (window as any).gsap;
      const ST = (window as any).ScrollTrigger;
      if (!g || !ST) return;

      g.registerPlugin(ST);

      const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      if (prefersReducedMotion) return;

      ST.matchMedia({
        "(min-width: 768px)": function () {
          const stacks = document.querySelectorAll<HTMLElement>("[data-story-stack]");

          stacks.forEach((stack) => {
            const viewport = stack.querySelector<HTMLElement>("[data-story-viewport]");
            const cards = Array.from(stack.querySelectorAll<HTMLElement>("[data-story-card]"));
            if (!viewport || cards.length < 2) return;

            g.set(cards, { opacity: 0 });
            g.set(cards[0], { opacity: 1 });

            const tl = g.timeline({
              scrollTrigger: {
                trigger: stack,
                start: "top top",
                end: "+=" + window.innerHeight * (cards.length - 1),
                scrub: 1,
                pin: viewport,
              },
            });

            cards.forEach((card, i) => {
              if (i === 0) return;
              tl.to(cards[i - 1], { opacity: 0, duration: 0.5 }, i - 0.5);
              tl.to(card, { opacity: 1, duration: 0.5 }, i - 0.5);
            });
          });

          return () => {
            ST.getAll().forEach((trigger: any) => trigger.kill());
          };
        },
      });
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", setUpStoryStacks);
    } else {
      setUpStoryStacks();
    }
  </script>
</PageLayout>

<style>
  section {
    padding-top: var(--space-3xl);
    padding-bottom: var(--space-3xl);
    border-top: var(--border-1) solid var(--border-subtle);
  }

  .hero {
    padding-top: 0;
    border-top: none;
  }

  h1 {
    font-size: var(--text-h1-size-fluid);
    line-height: var(--text-h1-leading);
    font-weight: var(--text-h1-weight);
    letter-spacing: var(--text-h1-tracking);
    max-width: var(--content-max);
  }

  .lead {
    margin-top: var(--space-lg);
    max-width: var(--content-max);
    font-size: var(--text-body-lg-size);
    line-height: var(--text-body-lg-leading);
    color: var(--text-secondary);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-xl);
    margin-top: var(--space-xl);
  }

  /* Rounded-rectangle "mark" treatment — see Header.astro's .cta for the
     full rationale (2026-09-05, owner-specified: echo the logo mark). */
  .cta {
    position: relative;
    z-index: 0;
    overflow: hidden;
    display: inline-flex;
    padding: var(--space-sm) calc(var(--space-xl) * 2);
    color: var(--action-primary-text);
    border-radius: var(--radius-2);
    box-shadow: var(--shadow-1);
    text-decoration: none;
    font-weight: var(--text-label-lg-weight);
    transition: transform var(--motion-fast) var(--ease-out), box-shadow var(--motion-fast) var(--ease-out);
  }

  /* Signature Shape as a genuine cutout — see Header.astro's .cta::before
     for the full rationale (2026-09-05, owner-specified): it mirrors how
     the shape works inside the logo mark itself (negative space, not an
     inked overlay), via a two-mask XOR trick that cuts a shape-sized
     hole through this ::before's own fill, revealing whatever's actually
     behind the button.

     Corner touch, same day: the mark's own ink only reaches this box's
     left edge in its upper portion and never touches the exact
     bottom-left corner point — confirmed by sampling rendered pixels,
     not guessed. No rotation/flip (owner ruled that out) — cropped from
     the top instead (mask-size 90% vs. the un-cropped default, position
     left top vs. left bottom), stretching that ink-bearing upper-left
     region down across more of the box so it reaches further toward
     the corner than the original plain fit did. A little gap remains
     right at the corner pixel; closing it fully needs a mirrored/rotated
     source asset. */
  .cta::before {
    content: "";
    position: absolute;
    z-index: -1;
    inset: 0;
    border-radius: inherit;
    background: var(--gradient-button);
    transition: background var(--motion-fast) var(--ease-out);
    -webkit-mask-image: linear-gradient(#000 0 0), url("/images/signature-shape.svg");
    -webkit-mask-repeat: no-repeat, no-repeat;
    -webkit-mask-position: 0 0, left top;
    -webkit-mask-size: 100% 100%, auto 90%;
    -webkit-mask-composite: xor;
    mask-image: linear-gradient(#000 0 0), url("/images/signature-shape.svg");
    mask-repeat: no-repeat, no-repeat;
    mask-position: 0 0, left top;
    mask-size: 100% 100%, auto 90%;
    mask-composite: exclude;
  }
  .cta:hover::before {
    background: var(--gradient-button-hover);
  }

  .cta:active::before {
    background: var(--gradient-button-active);
  }

  /* Lift on hover, press back down on active — a neutral (uncolored)
     shadow step-up + a small upward nudge, not a color change, so it
     reads clearly without touching the locked no-colored-shadows rule.
     Same treatment on .cta-secondary/.cta-on-gradient for consistency
     (2026-09-05, owner-specified). */
  .cta:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-2);
  }

  .cta:active {
    transform: translateY(0);
    box-shadow: var(--shadow-1);
  }

  .quick-nav {
    display: flex;
    gap: var(--space-lg);
  }

  .quick-nav a {
    color: var(--text-accent);
    text-decoration: none;
    font-size: var(--text-label-md-size);
    font-weight: var(--text-label-md-weight);
  }

  .quick-nav a:hover {
    color: var(--link-hover);
  }

  h2 {
    font-size: var(--text-h2-size-fluid);
    line-height: var(--text-h2-leading);
    font-weight: var(--text-h2-weight);
    max-width: var(--content-max);
  }

  .why-body,
  .meaning-body {
    margin-top: var(--space-md);
    max-width: var(--content-max);
    display: grid;
    gap: var(--space-xs);
  }

  .why-body p,
  .meaning-body p {
    font-size: var(--text-body-lg-size);
    line-height: var(--text-body-lg-leading);
    color: var(--text-secondary);
  }

  .eyebrow {
    font-size: var(--text-overline-size);
    font-weight: var(--text-overline-weight);
    letter-spacing: var(--text-overline-tracking);
    text-transform: uppercase;
    color: var(--text-accent);
    margin-bottom: var(--space-sm);
  }

  /* ---------- Story stack: mobile default is a plain sticky-peek list (CSS only) ---------- */
  .story-viewport {
    position: relative;
    margin-top: var(--space-lg);
    max-width: var(--container-lg);
  }

  .story-card {
    position: sticky;
    top: var(--space-lg);
    display: flex;
    gap: var(--space-lg);
    padding: var(--space-lg);
    margin-bottom: var(--space-lg);
    background: var(--surface-1);
    border: var(--border-1) solid var(--border-subtle);
    border-radius: var(--radius-3);
    box-shadow: var(--shadow-2);
  }

  .story-number {
    flex-shrink: 0;
    font-size: var(--text-h4-size);
    font-weight: var(--text-h4-weight);
    color: var(--border-strong);
  }

  .story-name {
    font-size: var(--text-h6-size);
    font-weight: var(--text-h6-weight);
    color: var(--text-primary);
  }

  .story-label {
    margin-top: var(--space-sm);
    font-size: var(--text-caption-size);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--text-secondary);
  }

  .story-text {
    margin-top: 2px;
    color: var(--text-secondary);
    font-size: var(--text-body-sm-size);
    line-height: var(--text-body-sm-leading);
  }

  /* ---------- Desktop: GSAP-pinned cross-fade story cards ---------- */
  @media (min-width: 768px) {
    .story-viewport {
      height: 60vh;
      min-height: 380px;
      max-height: 520px;
    }

    .story-card {
      position: absolute;
      inset: 0;
      margin-bottom: 0;
      flex-direction: column;
      justify-content: center;
      padding: var(--space-2xl);
    }

    .story-card:not(:first-child) {
      opacity: 0;
    }

    .story-number {
      font-size: var(--text-display-sm-size);
      color: var(--border-strong);
      opacity: 0.5;
    }

    .story-name {
      font-size: var(--text-h3-size);
      line-height: var(--text-h3-leading);
    }

    .story-text {
      font-size: var(--text-body-lg-size);
      line-height: var(--text-body-lg-leading);
      max-width: var(--content-max);
    }
  }

  /* ---------- Closing: animated brand gradient ---------- */
  .closing-wrap {
    border-top: none;
  }

  .closing {
    padding: var(--space-3xl) var(--space-2xl);
    border-radius: var(--radius-4);
    color: var(--text-inverse);
  }

  .closing h2 {
    color: var(--text-inverse);
  }

  .closing-lead {
    color: rgb(255 255 255 / 0.82);
  }

  .cta-on-gradient {
    margin-top: var(--space-xl);
    color: var(--accent-800);
  }

  /* This variant's fill is white, not the brown gradient — so its cutout
     reveals the animated .gradient-brand section showing straight
     through the button, not a flat page color. Same mask mechanism as
     the base .cta::before, just overriding the fill color per state. */
  .cta-on-gradient::before {
    background: var(--neutral-0);
  }

  .cta-on-gradient:hover::before {
    background: var(--neutral-100);
  }

  .cta-on-gradient:active::before {
    background: var(--neutral-200);
  }
</style>
