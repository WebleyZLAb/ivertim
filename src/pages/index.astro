---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import { blogTopicLabel, estimateReadingMinutes } from "../lib/blog";
// ⚠️ DRAFT — AI-generated placeholder photos (GPT Image), not real photography.
// Per docs/10 - Photo Prompts.md: these exist only to check real container
// sizes/proportions before commissioning real photography. Not yet confirmed
// for the live site — see CLAUDE.md 2026-09-07 session notes before committing.
import hero1 from "../assets/hero/hero-1-usluzno-rezanje.png";
import hero2 from "../assets/hero/hero-2-kantovanje-busenje.png";
import hero3 from "../assets/hero/hero-3-mjerenje-dogovor.png";
import hero4 from "../assets/hero/hero-4-namjestaj-po-mjeri.png";

const services = (await getCollection("usluge")).sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));
const articles = (await getCollection("blog")).sort((a, b) => Number(b.data.featured ?? false) - Number(a.data.featured ?? false) || b.data.publishDate.getTime() - a.data.publishDate.getTime()).slice(0, 3);
const projects = (await getCollection("projekti")).sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99)).slice(0, 2);
// Approved cutting-service process: Process Blueprint §10a.
const steps = [
  { title: "Nacrt ili mjere", text: "Precizan rezultat počinje tačnim ulaznim podatkom.", result: "Sigurnost da će obrada odgovarati vašem nacrtu ili mjerama." },
  { title: "Potvrda materijala, formata i roka", text: "Jasan dogovor prije obrade sprječava nesporazume i kašnjenje.", result: "Potvrđen materijal, format i rok prije nego što obrada počne." },
  { title: "Obrada i preuzimanje ili dostava", text: "Rezultat mora biti gotov za montažu na vašoj strani, bez dodatne dorade.", result: "Materijal isječen, okantovan i, po potrebi, izbušen prema dogovoru — spreman za preuzimanje ili dostavu." },
];
const heroSlides = [
  { label: "Uslužno rezanje", tone: "tone-1", src: hero1 },
  { label: "Kantovanje i bušenje", tone: "tone-2", src: hero2 },
  { label: "Mjerenje i dogovor", tone: "tone-3", src: hero3 },
  { label: "Namještaj po mjeri", tone: "tone-4", src: hero4 },
];
---

<BaseLayout
  title="Kompetentnost kojoj vjeruješ"
  description="Ivertim — precizna obrada pločastog materijala, od uslužnog rezanja do namještaja po mjeri, iz Prijedora."
>
  <Header />
  <main id="main-content">
    <section class="section hero" aria-labelledby="hero-heading">
      <div id="hero-carousel" class="hero-carousel" role="img" aria-label="Faze saradnje sa Ivertim-om — uslužno rezanje, kantovanje i bušenje, mjerenje i dogovor, namještaj po mjeri">
        {
          heroSlides.map((slide, index) => (
            <div class:list={["hero-slide", slide.tone]}>
              <Image class="hero-slide-img" src={slide.src} alt="" width={1600} height={900} widths={[480, 800, 1280, 1600]} sizes="(max-width: 1280px) 100vw, 1280px" loading={index === 0 ? "eager" : "lazy"} fetchpriority={index === 0 ? "high" : "auto"} />
            </div>
          ))
        }
      </div>
      <div class="hero-scrim" aria-hidden="true"></div>

      <button class="carousel-toggle" type="button" aria-controls="hero-carousel" aria-pressed="false" hidden>Pauziraj fotografije</button>
      <div class="hero-content">
        <div class="hero-bottom">
          <h1 id="hero-heading" class="hero-heading">Precizna obrada pločastog materijala — od uslužnog rezanja do namještaja po mjeri.</h1>
          <div class="hero-copy">
            <p class="lead">
              Nekome treba samo precizno isječen i okantovan materijal, nekome kompletno rješenje po mjeri prostora. Zato ne počinjemo od gotovog proizvoda, već od razumijevanja onoga što vam zaista treba.
            </p>
            <div class="hero-actions">
              <a class="cta-secondary" href="/proces-saradnje">Pogledajte kako radimo</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="section about" aria-labelledby="about-heading" data-reveal>
      <div class="about-stats">
        <div class="about-stats-header">
          <img class="about-stats-mark" src="/images/logo-mark-inverse.svg" alt="" aria-hidden="true" />
          <p class="about-stats-tagline">Kompetentnost kojoj vjeruješ</p>
        </div>

        <div class="about-stats-counters">
          <div class="counter">
            <p class="counter-value" data-counter data-target="16" data-suffix="+">16+</p>
            <p class="counter-label">Godina rada</p>
          </div>
          <div class="counter">
            <p class="counter-value" data-counter data-target="500" data-suffix="+">500+</p>
            <p class="counter-label">Zadovoljnih klijenata</p>
          </div>
        </div>
      </div>

      <div class="about-text">
        <p class="eyebrow">Ko smo mi</p>
        <h2 id="about-heading">Preuzimamo odgovornost za cijeli proces</h2>
        <p class="section-lead">
          Ivertim nije samo proizvođač namještaja. Naša vrijednost je sposobnost da preuzmemo odgovornost za cijeli proces — od prvog razgovora i mjerenja, do prijedloga, proizvodnje i, gdje je potrebno, montaže i postprodajne brige.
        </p>
      </div>
    </section>

    <section class="section services" aria-labelledby="services-heading">
      <div class="section-intro">
        <div><p class="eyebrow">Usluge</p><h2 id="services-heading">Dvije usluge. Jedan isti pristup preciznosti.</h2></div>
        <p class="section-lead">Bilo da vam treba precizno isječen i okantovan materijal ili kompletan namještaj po mjeri, pristupamo im na isti način — prvo razumijemo šta vam treba, zatim izmjerimo, pa tek onda predlažemo najbolje rješenje.</p>
      </div>
      <div class="service-bands">
        {services.map((service, index) => (
          <article class:list={["service-band", { "service-band--reverse": index % 2 === 1 }]}>
            {/* ⚠️ DRAFT — existing AI placeholder, awaiting real service photography. */}
            {service.data.heroImage && <Image class="service-image" src={service.data.heroImage} alt={index === 0 ? "Ilustracija obrade pločastog materijala" : "Ilustracija namještaja po mjeri"} width={800} height={600} widths={[400, 640, 800]} sizes="(min-width: 1024px) 600px, 100vw" loading="lazy" />}
            <div class="service-copy">
              <p class="eyebrow">{index === 0 ? "01 / Obrada materijala" : "02 / Namještaj po mjeri"}</p>
              <h3>{service.data.title}</h3>
              <p>{service.data.description}</p>
              {index === 1 && <p class="capacity-note">Kapacitet za izradu po mjeri zavisi od trenutnog obima uslužnog rezanja — javite se i reći ćemo vam realno stanje prije nego išta dogovorimo.</p>}
              <a class="link-cta" href={"/usluge/" + service.id}>Saznajte više <span aria-hidden="true">↗</span><span class="sr-only"> — {service.data.title}</span></a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="section process" aria-labelledby="process-heading">
      <div class="section-intro">
        <div><p class="eyebrow">Proces saradnje</p><h2 id="process-heading">Proces postoji da bi neizvjesnost pretvorio u sigurnost.</h2></div>
        <div><p class="section-lead">Svaki korak postoji kako bi odluke bile donesene na vrijeme, a projekat tekao jasno i bez nepotrebnih iznenađenja.</p><a class="link-cta" href="/proces-saradnje">Pogledajte cijeli proces <span aria-hidden="true">↗</span></a></div>
      </div>
      <div class="process-layout">
        <figure class="process-photo">
          {/* ⚠️ DRAFT — existing AI illustration, not a real completed project. */}
          <Image src={hero3} alt="Ilustracija provjere mjera i nacrta prije obrade" width={800} height={900} widths={[400, 640, 800]} sizes="(min-width: 1024px) 500px, 100vw" loading="lazy" />
          <figcaption>Uslužno rezanje, kantovanje i bušenje</figcaption>
        </figure>
        <ol class="process-steps">
          {steps.map((step, index) => <li><span class="step-number" aria-hidden="true">0{index + 1}</span><div><h3>{step.title}</h3><p>{step.text}</p><p class="step-result">{step.result}</p></div></li>)}
        </ol>
      </div>
      <div class="furniture-process"><h3>Namještaj po mjeri</h3><p>Razgovor → Mjerenje → Prijedlog → Potvrda → Proizvodnja → Montaža</p><a class="link-cta" href="/proces-saradnje#namjestaj">Pogledajte korake <span aria-hidden="true">↗</span></a></div>
    </section>

    <section class="section proof" aria-labelledby="proof-heading">
      <div><p class="eyebrow">Projekti</p><h2 id="proof-heading">Ne prikazujemo namještaj. Prikazujemo riješene prostore.</h2></div>
      <div><p class="section-lead">Svaki projekat nastaje iz konkretnog problema. Zato ne prikazujemo samo gotove enterijere, već način razmišljanja koji je doveo do rješenja.</p>
      {projects.length === 0 ? <p class="project-status">Prvi projekti stižu uskoro.</p> : <ul class="project-links">{projects.map(project => <li><a class="link-cta" href={"/projekti/" + project.id}>{project.data.title} <span aria-hidden="true">↗</span></a><p>{project.data.description}</p></li>)}</ul>}
      <a class="link-cta" href="/projekti">Pogledajte projekte <span aria-hidden="true">↗</span></a></div>
    </section>

    {articles.length > 0 && <section class="section advice" aria-labelledby="advice-heading">
      <div class="section-intro"><div><p class="eyebrow">Savjeti</p><h2 id="advice-heading">Znanje koje pomaže prije nego što donesete odluku.</h2></div><a class="link-cta" href="/blog">Istražite savjete <span aria-hidden="true">↗</span></a></div>
      <div class="advice-grid">{articles.map(article => <article class="advice-item">
        {/* ⚠️ DRAFT — existing AI article illustration, awaiting real photography. */}
        {article.data.heroImage && <Image src={article.data.heroImage} alt="" width={640} height={400} widths={[400, 640]} sizes="(min-width: 1024px) 400px, 100vw" loading="lazy" />}
        <p class="article-meta">{blogTopicLabel(article.data.topic)} · {estimateReadingMinutes(article.body)} min čitanja</p>
        <h3><a href={"/blog/" + article.id}>{article.data.title} <span aria-hidden="true">↗</span></a></h3>
      </article>)}</div>
    </section>}

    <section class="section closing-wrap" aria-labelledby="closing-heading" data-reveal>
      <div class="closing gradient-brand">
        <div class="closing-title"><p class="eyebrow">Razgovarajmo</p><h2 id="closing-heading">Prvi korak je razgovor.</h2></div><div class="closing-copy">
        <p class="section-lead closing-lead">
          Svaki projekat počinje drugačije, ali uvijek istim prvim korakom. Razgovor nam pomaže da razumijemo vaš prostor, potrebe i očekivanja kako bismo zajedno pronašli najbolje rješenje.
        </p>
        <p class="reassurance">Nema obaveze. Nema pritiska. Samo razgovor.</p>
        <a class="cta cta-on-gradient" href="/kontakt">Razgovarajmo</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<script>
  // Count-up for the two business stats in the dark "about" card — starts
  // once the card scrolls into view, not on page load, since it's well
  // below the fold. HTML already carries the real final value (e.g.
  // "16+") so a no-JS visitor still sees the correct number; JS only
  // resets to "0" right before animating it back up.
  const counters = document.querySelectorAll<HTMLElement>("[data-counter]");
  const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  function animateCounter(el: HTMLElement) {
    const target = Number(el.dataset.target ?? "0");
    const suffix = el.dataset.suffix ?? "";
    const duration = 1400;
    const start = performance.now();

    function tick(now: number) {
      const progress = Math.min((now - start) / duration, 1);
      const eased = 1 - Math.pow(1 - progress, 3);
      el.textContent = `${Math.round(target * eased)}${suffix}`;
      if (progress < 1) requestAnimationFrame(tick);
    }

    requestAnimationFrame(tick);
  }

  if (counters.length && !prefersReducedMotion && "IntersectionObserver" in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            animateCounter(entry.target as HTMLElement);
            observer.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.6 }
    );
    counters.forEach((el) => observer.observe(el));
  }
  const hero = document.querySelector<HTMLElement>(".hero");
  const toggle = document.querySelector<HTMLButtonElement>(".carousel-toggle");
  const motion = window.matchMedia("(prefers-reduced-motion: reduce)");
  let paused = false;
  function updateCarousel() {
    hero?.classList.toggle("is-playing", !paused && !motion.matches);
    if (toggle) {
      toggle.hidden = motion.matches;
      toggle.textContent = paused ? "Pokreni fotografije" : "Pauziraj fotografije";
      toggle.setAttribute("aria-pressed", String(paused));
    }
  }
  toggle?.addEventListener("click", () => { paused = !paused; updateCarousel(); });
  motion.addEventListener("change", updateCarousel);
  updateCarousel();
  // Reduced motion (or no IntersectionObserver support): leave the
  // server-rendered final values in place, animate nothing.
</script>

<style>
  main {
    max-width: var(--container-xl);
    margin: 0 auto;
  }

  .section {
    padding: var(--space-3xl) var(--container-padding);
    border-top: none;
  }

  /* Hero now IS the photo — text overlays it directly (owner's ask,
     2026-09-08), instead of a separate image block below the text.
     .hero-carousel/.hero-scrim are absolutely positioned (inset:0) so
     they always cover whatever height .hero ends up being; .hero-content
     stays in normal flow as the flex container's one real child, so
     min-height is only a floor, never a cap — on mobile, where the H1
     wraps to more lines, .hero grows taller instead of clipping text
     against a fixed box (a real bug caught here: the first version made
     .hero-content position:absolute + inset:0 too, which clipped the
     heading's top line on narrow viewports once it wrapped past what
     560px could fit). */
  .hero {
    position: relative;
    border-top: none;
    padding: 0;
    border-radius: var(--radius-4);
    overflow: hidden;
    min-height: 560px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }

  @media (min-width: 768px) {
    .hero {
      min-height: 680px;
      /* Pull the hero up under the floating navbar pill so the photo
         overlaps its bottom half — owner's ask, 2026-09-08. Header.astro
         gives the pill z-index: var(--z-sticky) so it stays visually on
         top of the (later-in-DOM, otherwise higher-painting) hero; this
         negative margin is roughly half the pill's own rendered height
         (~76px per Header.astro's own geometry comment) — verify against
         the real measured height and adjust if it drifts. */
      margin-top: -38px;
    }
  }

  .hero-content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    padding: var(--space-2xl) var(--container-padding) var(--space-xl);
  }

  /* Heading bottom-left, description+CTAs as a narrower block bottom-
     right — compatto.gr's own hero split (owner-referenced screenshots,
     2026-09-08), stacked on mobile like every other two-column pattern
     on this site. */
  .hero-bottom {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  @media (min-width: 768px) {
    .hero-bottom {
      flex-direction: row;
      /* Top-aligned, not bottom-aligned — the heading wraps to more
         lines than the copy column, so bottom-aligning left their tops
         mismatched (heading starting visibly lower). Owner's ask,
         2026-09-08. */
      align-items: flex-start;
      justify-content: space-between;
      gap: var(--space-2xl);
    }

    .hero-heading {
      flex: 1 1 auto;
    }

    .hero-copy {
      flex: 0 0 340px;
      max-width: 340px;
    }
  }

  /* Text now sits on a photo, not the page background — override the
     default dark-on-light colors to light-on-dark, same pattern already
     used for .closing-lead/.reassurance on the gradient CTA section. */
  .hero-content h1 {
    color: var(--text-inverse);
  }

  .hero-content .lead {
    color: var(--text-inverse);
  }

  h1 {
    font-size: var(--text-display-sm-size-fluid);
    line-height: var(--text-display-sm-leading);
    font-weight: var(--text-display-sm-weight);
    letter-spacing: var(--text-display-sm-tracking);
    max-width: var(--content-max);
  }

  /* No top margin here — .lead used to stack directly under the H1 in
     one column; now it sits in its own .hero-copy column, bottom-aligned
     alongside the heading rather than below it. */
  .lead {
    max-width: var(--content-max);
    font-size: var(--text-body-lg-size);
    line-height: var(--text-body-lg-leading);
    color: var(--text-secondary);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-lg);
    margin-top: var(--space-xl);
  }

  /* ---------- Hero carousel: pure CSS crossfade, no JS ----------
     The carousel is now the hero's own background layer (owner's ask,
     2026-09-08) — it fills .hero completely (inset:0) instead of being
     its own sized box; .hero's min-height above is what actually sets
     how tall the photo reads as. */
  .hero-carousel {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero-slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    animation: hero-slide-fade 24s infinite;
    animation-play-state: paused;
  }

  /* Tone gradients now sit as a fallback background (visible only while
     the image loads, or if it ever fails) rather than the visible
     surface — the real image covers the slide on top of it. */
  .hero-slide.tone-1 {
    background: linear-gradient(135deg, var(--accent-500), var(--accent-700));
  }
  .hero-slide.tone-2 {
    background: linear-gradient(135deg, var(--accent-600), var(--accent-800));
  }
  .hero-slide.tone-3 {
    background: linear-gradient(135deg, var(--accent-800), var(--accent-950));
  }
  .hero-slide.tone-4 {
    background: linear-gradient(135deg, var(--accent-700), var(--accent-900));
  }

  .hero-slide-img {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* One static scrim for the whole hero, not a per-slide ::after — the
     H1/lead/CTA block now needs to stay readable continuously, including
     mid-crossfade when two photos briefly overlap, so this can't be tied
     to any single slide's own opacity animation. Strongest at the bottom
     where the text sits, fading out toward the top so the photo itself
     still reads clearly higher up. */
  .hero-scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(to top, var(--bg-inverse), var(--overlay-heavy) 45%, var(--overlay-light));
  }

  /* True crossfade, not sequential fade-to-nothing-then-fade-in: each
     slide's fade-out (20.83%–29.17% of its own 24s timeline = seconds
     5–7) deliberately overlaps the next slide's fade-in (0%–4.17% =
     seconds 0–1), since the next slide's delay lands its own 0% exactly
     at second 6 of this slide's timeline. That shared 1s window is where
     one slide is finishing its fade down while the next is finishing its
     fade up, so there's always visible photo on screen — never a moment
     where every slide is near-zero at once (the old 3%/22%/25% timing
     ended this slide's fade-out exactly when the next one's fade-in
     began, instead of overlapping it). */
  @keyframes hero-slide-fade {
    0%, 25% { opacity: 1; }
    33.33%, 91.67% { opacity: 0; }
    100% { opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-slide {
      animation: none;
      opacity: 0;
    }
    .hero-slide:first-child {
      opacity: 1;
    }
  }

  h2 {
    font-size: var(--text-h2-size-fluid);
    line-height: var(--text-h2-leading);
    font-weight: var(--text-h2-weight);
    letter-spacing: var(--text-h2-tracking);
    max-width: var(--content-max);
  }

  .section-lead {
    margin-top: var(--space-md);
    max-width: var(--content-max);
    font-size: var(--text-body-lg-size);
    line-height: var(--text-body-lg-leading);
    color: var(--text-secondary);
  }

  /* Rounded-rectangle "mark" treatment — see Header.astro's .cta for the
     full rationale (2026-09-05, owner-specified: echo the logo mark). */
  .cta {
    position: relative;
    z-index: 0;
    overflow: hidden;
    display: inline-flex;
    padding: var(--space-sm) calc(var(--space-xl) * 2);
    color: var(--action-primary-text);
    border-radius: var(--radius-2);
    box-shadow: var(--shadow-1);
    text-decoration: none;
    font-weight: var(--text-label-lg-weight);
    transition: transform var(--motion-fast) var(--ease-out), box-shadow var(--motion-fast) var(--ease-out);
  }

  /* Signature Shape as a genuine cutout — see Header.astro's .cta::before
     for the full rationale (2026-09-05, owner-specified): it mirrors how
     the shape works inside the logo mark itself (negative space, not an
     inked overlay), via a two-mask XOR trick that cuts a shape-sized
     hole through this ::before's own fill, revealing whatever's actually
     behind the button.

     Corner touch, same day: tried cropping the mark further toward the
     corner (mask-size 90%, position left top) — reverted; it turned the
     recognizable curve into a flat, blocky rectangle (owner: "ne valja"),
     worse than the small gap it was meant to fix. Back to auto 62%/left
     bottom, which keeps the shape looking like itself.

     Bottom-edge bleed, 2026-09-05: see Header.astro's .cta::before for
     the full story — nudged this layer's mask-position from `left bottom`
     to `0 calc(100% + 4px)` so the mark's existing ink bleeds a few px
     past the button's true bottom edge instead of landing exactly on it,
     closing a visible seam the live mask rasterization left behind. */
  .cta::before {
    content: "";
    position: absolute;
    z-index: -1;
    inset: 0;
    border-radius: inherit;
    background: var(--gradient-button);
    transition: background var(--motion-fast) var(--ease-out);
    -webkit-mask-image: linear-gradient(#000 0 0), url("/images/signature-shape.svg");
    -webkit-mask-repeat: no-repeat, no-repeat;
    -webkit-mask-position: 0 0, 0 calc(100% + 4px);
    -webkit-mask-size: 100% 100%, auto 62%;
    -webkit-mask-composite: xor;
    mask-image: linear-gradient(#000 0 0), url("/images/signature-shape.svg");
    mask-repeat: no-repeat, no-repeat;
    mask-position: 0 0, 0 calc(100% + 4px);
    mask-size: 100% 100%, auto 62%;
    mask-composite: exclude;
  }

  .cta:hover::before {
    background: var(--gradient-button-hover);
  }

  .cta:active::before {
    background: var(--gradient-button-active);
  }

