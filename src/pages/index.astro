     entirely instead of fighting it with a crop percentage. */
  .about-stats::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: 0;
    width: 108px;
    aspect-ratio: 169.44 / 179.65;
    background: rgb(255 255 255 / 0.18);
    -webkit-mask-image: url("/images/signature-shape.svg");
    -webkit-mask-repeat: no-repeat;
    -webkit-mask-position: left calc(100% + 4px);
    -webkit-mask-size: contain;
    mask-image: url("/images/signature-shape.svg");
    mask-repeat: no-repeat;
    mask-position: left calc(100% + 4px);
