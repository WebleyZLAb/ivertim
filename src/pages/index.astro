---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { getCollection } from "astro:content";

const usluge = (await getCollection("usluge")).sort(
  (a, b) => (a.data.order ?? 99) - (b.data.order ?? 99)
);

const heroSlides = [
  { label: "Uslužno rezanje", tone: "tone-1" },
  { label: "Kantovanje i bušenje", tone: "tone-2" },
  { label: "Mjerenje i dogovor", tone: "tone-3" },
  { label: "Namještaj po mjeri", tone: "tone-4" },
];
---

<BaseLayout
  title="Kompetentnost kojoj vjeruješ"
  description="Ivertim — precizna obrada pločastog materijala, od uslužnog rezanja do namještaja po mjeri, iz Prijedora."
>
  <Header />
  <main>
    <section class="section hero" aria-labelledby="hero-heading" data-reveal>
      <div class="hero-text">
        <h1 id="hero-heading">Precizna obrada pločastog materijala — od uslužnog rezanja do namještaja po mjeri.</h1>
        <p class="lead">
          Nekome treba samo precizno isječen i okantovan materijal, nekome kompletno rješenje po mjeri prostora. Zato ne počinjemo od gotovog proizvoda, već od razumijevanja onoga što vam zaista treba.
        </p>
        <div class="hero-actions">
          <a class="cta" href="/kontakt">Razgovarajmo</a>
          <a class="cta-secondary" href="/proces-saradnje">Pogledajte kako radimo</a>
        </div>
      </div>

      <div class="hero-visual">
        <div class="hero-carousel" role="img" aria-label="Faze saradnje sa Ivertim-om — uslužno rezanje, kantovanje i bušenje, mjerenje i dogovor, namještaj po mjeri">
          {
            heroSlides.map((slide, index) => (
              <div class:list={["hero-slide", slide.tone]} style={`animation-delay: ${index * 6}s`}>
                <img class="hero-slide-shape" src="/images/signature-shape-inverse.svg" alt="" aria-hidden="true" />
                <p class="hero-slide-label">{slide.label}</p>
              </div>
            ))
          }
        </div>
        <p class="hero-carousel-note">Prikaz faza saradnje — prave fotografije procesa stižu uskoro.</p>
      </div>
    </section>

    <section class="section usluge" aria-labelledby="usluge-heading" data-reveal>
      <h2 id="usluge-heading">Dvije usluge. Jedan isti pristup preciznosti.</h2>
      <p class="section-lead">
        Bilo da vam treba precizno isječen i okantovan materijal ili kompletan namještaj po mjeri, pristupamo im na isti način — prvo razumijemo šta vam treba, zatim izmjerimo, pa tek onda predlažemo najbolje rješenje.
      </p>

      {
        usluge.length > 0 && (
          <div class="usluge-full">
            {usluge.map((usluga, index) => (
              <a class:list={["usluga-band", { "usluga-band--accent": index === 0 }]} href={`/usluge/${usluga.id}`}>
                <div class="usluga-band-inner">
                  <p class="eyebrow">{index === 0 ? "Primarna usluga" : "Sekundarna usluga"}</p>
                  <p class="usluga-title">{usluga.data.title}</p>
                  <p class="usluga-description">{usluga.data.description}</p>
                  <span class="usluga-link">Saznajte više →</span>
                </div>
              </a>
            ))}
          </div>
        )
      }
    </section>

    <section class="section about" aria-labelledby="about-heading" data-reveal>
      <div class="about-badges">
        <div class="badge">
          <img src="/images/logo-mark.svg" alt="" aria-hidden="true" />
          <p class="badge-title">Sopstvena fabrika i CNC mašine</p>
          <p class="badge-text">Svale bb, Prijedor</p>
        </div>
        <div class="badge">
          <img src="/images/logo-mark.svg" alt="" aria-hidden="true" />
          <p class="badge-title">Dvije usluge, jedan pristup</p>
          <p class="badge-text">Uslužno rezanje i namještaj po mjeri</p>
        </div>
      </div>

      <div class="about-text">
        <p class="eyebrow">Ko smo mi</p>
        <h2 id="about-heading">Preuzimamo odgovornost za cijeli proces</h2>
        <p class="section-lead">
          Ivertim nije samo proizvođač namještaja. Naša vrijednost je sposobnost da preuzmemo odgovornost za cijeli proces — od prvog razgovora i mjerenja, do prijedloga, proizvodnje i, gdje je potrebno, montaže i postprodajne brige.
        </p>
      </div>
    </section>

    <section class="section" aria-labelledby="process-heading" data-reveal>
      <h2 id="process-heading">Proces postoji da bi neizvjesnost pretvorio u sigurnost.</h2>
      <p class="section-lead">
        Svaki korak postoji kako bi odluke bile donesene na vrijeme, a projekat tekao jasno i bez nepotrebnih iznenađenja.
      </p>
      <a class="link-cta" href="/proces-saradnje">Pogledajte cijeli proces →</a>
    </section>

    <section class="section" aria-labelledby="proof-heading" data-reveal>
      <h2 id="proof-heading">Ne prikazujemo namještaj. Prikazujemo riješene prostore.</h2>
      <p class="section-lead">
        Svaki projekat nastaje iz konkretnog problema. Zato ne prikazujemo samo gotove enterijere, već način razmišljanja koji je doveo do rješenja.
      </p>
      <a class="link-cta" href="/projekti">Pogledajte projekte →</a>
    </section>

    <section class="section closing-wrap" aria-labelledby="closing-heading" data-reveal>
      <div class="closing gradient-brand">
        <h2 id="closing-heading">Prvi korak je razgovor.</h2>
        <p class="section-lead closing-lead">
          Svaki projekat počinje drugačije, ali uvijek istim prvim korakom. Razgovor nam pomaže da razumijemo vaš prostor, potrebe i očekivanja kako bismo zajedno pronašli najbolje rješenje.
        </p>
        <p class="reassurance">Nema obaveze. Nema pritiska. Samo razgovor.</p>
        <a class="cta cta-on-gradient" href="/kontakt">Razgovarajmo</a>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  main {
    max-width: var(--container-xl);
    margin: 0 auto;
  }

  .section {
    padding: var(--space-3xl) var(--container-padding);
    border-top: var(--border-1) solid var(--border-subtle);
  }

  .hero {
    position: relative;
    border-top: none;
    padding-top: var(--space-2xl);
    display: grid;
    gap: var(--space-2xl);
  }

  .hero-text {
    position: relative;
  }

  h1 {
    font-size: var(--text-display-sm-size-fluid);
    line-height: var(--text-display-sm-leading);
    font-weight: var(--text-display-sm-weight);
    letter-spacing: var(--text-display-sm-tracking);
    max-width: var(--content-max);
  }

  .lead {
    margin-top: var(--space-lg);
    max-width: var(--content-max);
    font-size: var(--text-body-lg-size);
    line-height: var(--text-body-lg-leading);
    color: var(--text-secondary);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-lg);
    margin-top: var(--space-xl);
  }

  /* ---------- Hero carousel: pure CSS crossfade, no JS ---------- */
  .hero-carousel {
    position: relative;
    height: 320px;
    border-radius: var(--radius-4);
    overflow: hidden;
  }

  .hero-slide {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-end;
    padding: var(--space-lg);
    opacity: 0;
    animation: hero-slide-fade 24s infinite;
  }

  .hero-slide.tone-1 {
    background: linear-gradient(135deg, var(--accent-500), var(--accent-700));
  }
  .hero-slide.tone-2 {
    background: linear-gradient(135deg, var(--accent-600), var(--accent-800));
  }
  .hero-slide.tone-3 {
    background: linear-gradient(135deg, var(--accent-800), var(--accent-950));
  }
  .hero-slide.tone-4 {
    background: linear-gradient(135deg, var(--accent-700), var(--accent-900));
  }

  /* Signature Shape corner accents always sit bottom-left, bleeding
     across the edge rather than staying fully inset — locked rule,
     2026-09-05 (see docs/09 - Signature System.md §Cards). Was
     top-right; mirrored in place (top/right → bottom/left, same
     magnitudes) rather than re-deriving new offsets.

     Sized off height, not width (fixed same day) — .hero-carousel has
     a fixed 320px height but a fluid width (full-width single-column
     below 768px, narrower grid column above it), so a width-relative
     size made the image's own rendered size swing wildly with viewport
     width. At ~700px wide specifically, width:65% produced an image
     taller than the 320px box, clipping straight through the middle of
     the swirl instead of bleeding cleanly off one edge — confirmed by
     measuring the image's rendered box at several widths. Tying the
     size to the container's stable height keeps the shape's own size
     constant regardless of viewport width. */
  .hero-slide-shape {
    position: absolute;
    bottom: -15%;
    left: -10%;
    height: 65%;
    width: auto;
    opacity: 0.16;
  }

  .hero-slide-label {
    position: relative;
    color: var(--text-inverse);
    font-size: var(--text-label-lg-size);
    font-weight: var(--text-label-lg-weight);
  }

  @keyframes hero-slide-fade {
    0%,
    100% {
      opacity: 0;
    }
    3%,
    22% {
      opacity: 1;
    }
    25% {
      opacity: 0;
    }
  }

  .hero-carousel-note {
    margin-top: var(--space-sm);
    font-size: var(--text-caption-size);
    /* text-secondary, not text-tertiary — same WCAG AA contrast issue as
       Footer.astro's labels; see the note there. */
    color: var(--text-secondary);
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-slide {
      animation: none;
      opacity: 0;
    }
    .hero-slide:first-child {
      opacity: 1;
    }
  }

  h2 {
    font-size: var(--text-h2-size-fluid);
    line-height: var(--text-h2-leading);
    font-weight: var(--text-h2-weight);
    letter-spacing: var(--text-h2-tracking);
    max-width: var(--content-max);
  }

  .section-lead {
    margin-top: var(--space-md);
    max-width: var(--content-max);
    font-size: var(--text-body-lg-size);
    line-height: var(--text-body-lg-leading);
    color: var(--text-secondary);
  }

  /* Rounded-rectangle "mark" treatment — see Header.astro's .cta for the
     full rationale (2026-09-05, owner-specified: echo the logo mark). */
  .cta {
    position: relative;
    z-index: 0;
    overflow: hidden;
    display: inline-flex;
    padding: var(--space-sm) calc(var(--space-xl) * 2);
    color: var(--action-primary-text);
    border-radius: var(--radius-2);
    box-shadow: var(--shadow-1);
    text-decoration: none;
    font-weight: var(--text-label-lg-weight);
    transition: transform var(--motion-fast) var(--ease-out), box-shadow var(--motion-fast) var(--ease-out);
  }

  /* Signature Shape as a genuine cutout — see Header.astro's .cta::before
     for the full rationale (2026-09-05, owner-specified): it mirrors how
     the shape works inside the logo mark itself (negative space, not an
     inked overlay), via a two-mask XOR trick that cuts a shape-sized
     hole through this ::before's own fill, revealing whatever's actually
     behind the button. */
  .cta::before {
    content: "";
    position: absolute;
    z-index: -1;
    inset: 0;
    border-radius: inherit;
    background: var(--gradient-button);
    transition: background var(--motion-fast) var(--ease-out);
    -webkit-mask-image: linear-gradient(#000 0 0), url("/images/signature-shape.svg");
    -webkit-mask-repeat: no-repeat, no-repeat;
    -webkit-mask-position: 0 0, left bottom;
    -webkit-mask-size: 100% 100%, auto 62%;
    -webkit-mask-composite: xor;
    mask-image: linear-gradient(#000 0 0), url("/images/signature-shape.svg");
    mask-repeat: no-repeat, no-repeat;
    mask-position: 0 0, left bottom;
    mask-size: 100% 100%, auto 62%;
    mask-composite: exclude;
  }

  .cta:hover::before {
    background: var(--gradient-button-hover);
  }

  .cta:active::before {
    background: var(--gradient-button-active);
  }

  /* Lift on hover, press back down on active — a neutral (uncolored)
     shadow step-up + a small upward nudge, not a color change, so it
     reads clearly without touching the locked no-colored-shadows rule.
     Same treatment on .cta-secondary for consistency (2026-09-05,
     owner-specified). */
  .cta:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-2);
  }

  .cta:active {
    transform: translateY(0);
    box-shadow: var(--shadow-1);
  }

  /* Outline treatment, 2026-09-05 — border carries the same gradient as
     the primary button (--gradient-button), via the standard two-layer
     background trick: an opaque page-bg fill clipped to the padding-box
     sits under the gradient clipped to the border-box, so only the 2px
     ring shows the gradient and the interior stays flat page-background. */
  .cta-secondary {
    display: inline-flex;
    align-items: center;
    padding: var(--space-sm) var(--space-xl);
    border: 2px solid transparent;
    border-radius: var(--radius-2);
    background:
      linear-gradient(var(--bg-primary), var(--bg-primary)) padding-box,
      var(--gradient-button) border-box;
    color: var(--action-primary);
    text-decoration: none;
    font-weight: var(--text-label-lg-weight);
    transition: background var(--motion-fast) var(--ease-out), color var(--motion-fast) var(--ease-out),
      transform var(--motion-fast) var(--ease-out), box-shadow var(--motion-fast) var(--ease-out);
  }

  .cta-secondary:hover {
    background:
      linear-gradient(var(--bg-primary), var(--bg-primary)) padding-box,
      var(--gradient-button-glow) border-box;
    color: var(--action-primary-hover);
    transform: translateY(-2px);
    box-shadow: var(--shadow-2);
  }

  .cta-secondary:active {
    background:
      linear-gradient(var(--bg-primary), var(--bg-primary)) padding-box,
      var(--gradient-button-active) border-box;
    color: var(--action-primary-active);
    transform: translateY(0);
    box-shadow: var(--shadow-0);
  }

  .link-cta {
    display: inline-block;
    margin-top: var(--space-lg);
    color: var(--text-accent);
    text-decoration: none;
    font-weight: var(--text-label-md-weight);
  }

  .link-cta:hover {
    color: var(--link-hover);
  }

  .eyebrow {
    font-size: var(--text-overline-size);
    font-weight: var(--text-overline-weight);
    letter-spacing: var(--text-overline-tracking);
    text-transform: uppercase;
    color: var(--text-accent);
    margin-bottom: var(--space-xs);
  }

  /* ---------- Usluge: full-width stacked bands, not a card grid ---------- */
  .usluge-full {
    margin-top: var(--space-2xl);
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .usluga-band {
    position: relative;
    overflow: hidden;
    display: block;
    padding: var(--space-2xl);
    background: var(--surface-1);
    border: var(--border-1) solid var(--border-subtle);
    border-radius: var(--radius-4);
    text-decoration: none;
    transition: border-color var(--motion-fast) var(--ease-out);
  }

  .usluga-band:hover {
    border-color: var(--border-accent);
  }

  .usluga-band-inner {
    max-width: var(--content-max);
  }

  /* Bottom-left corner, height pinned to exactly half the card via
     top:50%+bottom:0 with width following the shape's own aspect ratio.
     Reverted same-day 115%-background-size experiment (2026-09-05):
     unlike the inverse file the button cutout uses, signature-shape.svg's
     own viewBox is already tightly cropped to the mark (~1-2% margin,
     confirmed via getBBox()) — oversizing it doesn't reveal more edge,
     it just zooms into and crops through the middle of the curve, which
     read as a broken/cut-off shape rather than a clean bleed. Plain
     `contain` already renders it flush to the box edges correctly. */
  .usluga-band--accent::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: 0;
    top: 50%;
    aspect-ratio: 169.44 / 179.65;
    background: url("/images/signature-shape.svg") no-repeat center / contain;
    opacity: 0.06;
    pointer-events: none;
  }

  .usluga-title {
    font-size: var(--text-h3-size-fluid);
    line-height: var(--text-h3-leading);
    font-weight: var(--text-h3-weight);
    color: var(--text-primary);
  }

  .usluga-description {
    margin-top: var(--space-sm);
    color: var(--text-secondary);
    font-size: var(--text-body-lg-size);
    line-height: var(--text-body-lg-leading);
  }

  .usluga-link {
    display: inline-block;
    margin-top: var(--space-lg);
    font-size: var(--text-label-md-size);
    font-weight: var(--text-label-md-weight);
    color: var(--text-accent);
  }

  /* ---------- About / trust badges ---------- */
  .about {
    display: grid;
    gap: var(--space-2xl);
  }

  .about-badges {
    display: grid;
    gap: var(--space-lg);
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .badge {
    padding: var(--space-xl);
    background: var(--surface-1);
    border: var(--border-1) solid var(--border-subtle);
    border-radius: var(--radius-3);
  }

  .badge img {
    width: 28px;
    height: 28px;
    margin-bottom: var(--space-md);
  }

  .badge-title {
    font-size: var(--text-h6-size);
    font-weight: var(--text-h6-weight);
    color: var(--text-primary);
  }

  .badge-text {
    margin-top: var(--space-xs);
    color: var(--text-secondary);
    font-size: var(--text-body-sm-size);
  }

  /* ---------- Closing: animated brand gradient ---------- */
  .closing-wrap {
    border-top: none;
    padding-top: var(--space-lg);
  }

  .closing {
    padding: var(--space-3xl) var(--space-2xl);
    border-radius: var(--radius-4);
    color: var(--text-inverse);
  }

  .closing h2 {
    color: var(--text-inverse);
  }

  .closing-lead {
    color: rgb(255 255 255 / 0.82);
  }

  .reassurance {
    margin-top: var(--space-lg);
    color: rgb(255 255 255 / 0.7);
    font-size: var(--text-body-sm-size);
  }

  .cta-on-gradient {
    margin-top: var(--space-xl);
    color: var(--accent-800);
  }

  /* This variant's fill is white, not the brown gradient — so its cutout
     reveals the animated .gradient-brand section showing straight
     through the button, not a flat page color. Same mask mechanism as
     the base .cta::before, just overriding the fill color per state. */
  .cta-on-gradient::before {
    background: var(--neutral-0);
  }

  .cta-on-gradient:hover::before {
    background: var(--neutral-100);
  }

  .cta-on-gradient:active::before {
    background: var(--neutral-200);
  }

  @media (min-width: 768px) {
    .hero {
      grid-template-columns: 1.1fr 1fr;
      align-items: center;
    }

    .about {
      grid-template-columns: 1fr 1.3fr;
      align-items: center;
    }
  }
</style>
