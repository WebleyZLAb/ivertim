---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { getCollection } from "astro:content";

const usluge = (await getCollection("usluge")).sort(
  (a, b) => (a.data.order ?? 99) - (b.data.order ?? 99)
);
---

<BaseLayout
  title="Kompetentnost kojoj vjeruješ"
  description="Ivertim — precizna obrada pločastog materijala, od uslužnog rezanja do namještaja po mjeri, iz Prijedora."
>
  <Header />
  <main>
    <section class="section hero" aria-labelledby="hero-heading" data-reveal>
      <img class="hero-signature" src="/images/signature-shape.svg" alt="" aria-hidden="true" />
      <h1 id="hero-heading">Precizna obrada pločastog materijala — od uslužnog rezanja do namještaja po mjeri.</h1>
      <p class="lead">
        Nekome treba samo precizno isječen i okantovan materijal, nekome kompletno rješenje po mjeri prostora. Zato ne počinjemo od gotovog proizvoda, već od razumijevanja onoga što vam zaista treba.
      </p>
      <div class="hero-actions">
        <a class="cta" href="/kontakt">Razgovarajmo</a>
        <a class="cta-secondary" href="/proces-saradnje">Pogledajte kako radimo</a>
      </div>
    </section>

    <section class="section" aria-labelledby="usluge-heading" data-reveal>
      <h2 id="usluge-heading">Dvije usluge. Jedan isti pristup preciznosti.</h2>
      <p class="section-lead">
        Bilo da vam treba precizno isječen i okantovan materijal ili kompletan namještaj po mjeri, pristupamo im na isti način — prvo razumijemo šta vam treba, zatim izmjerimo, pa tek onda predlažemo najbolje rješenje.
      </p>

      {
        usluge.length > 0 && (
          <ul class="usluge-list">
            {usluge.map((usluga, index) => (
              <li class:list={["usluga-card", { "usluga-card--accent": index === 0 }]}>
                <p class="eyebrow">{index === 0 ? "Primarna usluga" : "Sekundarna usluga"}</p>
                <a class="usluga-title" href={`/usluge/${usluga.id}`}>{usluga.data.title}</a>
                <p class="usluga-description">{usluga.data.description}</p>
              </li>
            ))}
          </ul>
        )
      }

      <a class="link-cta" href="/usluge">Istražite usluge →</a>
    </section>

    <section class="section" aria-labelledby="process-heading" data-reveal>
      <h2 id="process-heading">Proces postoji da bi neizvjesnost pretvorio u sigurnost.</h2>
      <p class="section-lead">
        Svaki korak postoji kako bi odluke bile donesene na vrijeme, a projekat tekao jasno i bez nepotrebnih iznenađenja.
      </p>
      <a class="link-cta" href="/proces-saradnje">Pogledajte cijeli proces →</a>
    </section>

    <section class="section" aria-labelledby="proof-heading" data-reveal>
      <h2 id="proof-heading">Ne prikazujemo namještaj. Prikazujemo riješene prostore.</h2>
      <p class="section-lead">
        Svaki projekat nastaje iz konkretnog problema. Zato ne prikazujemo samo gotove enterijere, već način razmišljanja koji je doveo do rješenja.
      </p>
      <a class="link-cta" href="/projekti">Pogledajte projekte →</a>
    </section>

    <section class="section closing" aria-labelledby="closing-heading" data-reveal>
      <h2 id="closing-heading">Prvi korak je razgovor.</h2>
      <p class="section-lead">
        Svaki projekat počinje drugačije, ali uvijek istim prvim korakom. Razgovor nam pomaže da razumijemo vaš prostor, potrebe i očekivanja kako bismo zajedno pronašli najbolje rješenje.
      </p>
      <p class="reassurance">Nema obaveze.<br />Nema pritiska.<br />Samo razgovor.</p>
      <a class="cta" href="/kontakt">Razgovarajmo</a>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  main {
    max-width: var(--container-xl);
    margin: 0 auto;
  }

  .section {
    padding: var(--space-3xl) var(--container-padding);
    border-top: var(--border-1) solid var(--border-subtle);
  }

  .hero {
    position: relative;
    overflow: hidden;
    border-top: none;
    padding-top: var(--space-2xl);
  }

  .hero-signature {
    position: absolute;
    top: -10%;
    right: -8%;
    width: 340px;
    height: 340px;
    opacity: 0.05;
    pointer-events: none;
  }

  h1 {
    font-size: var(--text-display-sm-size-fluid);
    line-height: var(--text-display-sm-leading);
    font-weight: var(--text-display-sm-weight);
    letter-spacing: var(--text-display-sm-tracking);
    max-width: var(--content-max);
  }

  .lead {
    margin-top: var(--space-lg);
    max-width: var(--content-max);
    font-size: var(--text-body-lg-size);
    line-height: var(--text-body-lg-leading);
    color: var(--text-secondary);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-lg);
    margin-top: var(--space-xl);
  }

  h2 {
    font-size: var(--text-h2-size-fluid);
    line-height: var(--text-h2-leading);
    font-weight: var(--text-h2-weight);
    letter-spacing: var(--text-h2-tracking);
    max-width: var(--content-max);
  }

  .section-lead {
    margin-top: var(--space-md);
    max-width: var(--content-max);
    font-size: var(--text-body-lg-size);
    line-height: var(--text-body-lg-leading);
    color: var(--text-secondary);
  }

  .cta {
    display: inline-flex;
    padding: var(--space-sm) var(--space-xl);
    background: var(--action-primary);
    color: var(--action-primary-text);
    border-radius: var(--radius-2);
    text-decoration: none;
    font-weight: var(--text-label-lg-weight);
  }

  .cta:hover {
    background: var(--action-primary-hover);
  }

  .cta-secondary {
    color: var(--text-secondary);
    text-decoration: none;
    font-weight: var(--text-label-lg-weight);
  }

  .cta-secondary:hover {
    color: var(--text-accent);
  }

  .link-cta {
    display: inline-block;
    margin-top: var(--space-lg);
    color: var(--text-accent);
    text-decoration: none;
    font-weight: var(--text-label-md-weight);
  }

  .link-cta:hover {
    color: var(--link-hover);
  }

  .usluge-list {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-lg);
    margin-top: var(--space-xl);
  }

  .eyebrow {
    font-size: var(--text-overline-size);
    font-weight: var(--text-overline-weight);
    letter-spacing: var(--text-overline-tracking);
    text-transform: uppercase;
    color: var(--text-accent);
    margin-bottom: var(--space-xs);
  }

  .usluga-card {
    position: relative;
    overflow: hidden;
    padding: var(--space-xl);
    background: var(--surface-1);
    border: var(--border-1) solid var(--border-subtle);
    border-radius: var(--radius-3);
  }

  .usluga-card--accent::after {
    content: "";
    position: absolute;
    right: -28px;
    bottom: -28px;
    width: 110px;
    height: 110px;
    background: url("/images/signature-shape.svg") no-repeat center / contain;
    opacity: 0.06;
    pointer-events: none;
  }

  .usluga-title {
    display: block;
    font-size: var(--text-h4-size);
    line-height: var(--text-h4-leading);
    font-weight: var(--text-h4-weight);
    color: var(--text-primary);
    text-decoration: none;
  }

  .usluga-title:hover {
    color: var(--text-accent);
  }

  .usluga-description {
    margin-top: var(--space-sm);
    color: var(--text-secondary);
  }

  .closing {
    text-align: left;
  }

  .reassurance {
    margin-top: var(--space-lg);
    /* text-secondary, not text-tertiary — at 14px, text-tertiary (neutral-500) only
       reaches ~3.1:1 contrast here, below WCAG AA's 4.5:1 for normal text. */
    color: var(--text-secondary);
    font-size: var(--text-body-sm-size);
  }

  .closing .cta {
    margin-top: var(--space-xl);
  }

  @media (min-width: 768px) {
    .usluge-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
