---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { Image } from "astro:assets";
// ⚠️ DRAFT — AI-generated placeholder photos (GPT Image), not real photography.
// Per docs/10 - Photo Prompts.md: these exist only to check real container
// sizes/proportions before commissioning real photography. Not yet confirmed
// for the live site — see CLAUDE.md 2026-09-07 session notes before committing.
import hero1 from "../assets/hero/hero-1-usluzno-rezanje.png";
import hero2 from "../assets/hero/hero-2-kantovanje-busenje.png";
import hero3 from "../assets/hero/hero-3-mjerenje-dogovor.png";
import hero4 from "../assets/hero/hero-4-namjestaj-po-mjeri.png";
// Reused for the new "benefits" bento's image card (see the section below)
// — a room photo, not one of the four hero slides above, so it doesn't
// repeat an image already visible higher on this same page.
import benefitsImage from "../assets/rooms/kuhinje.png";

const heroSlides = [
  { label: "Uslužno rezanje", tone: "tone-1", src: hero1 },
  { label: "Kantovanje i bušenje", tone: "tone-2", src: hero2 },
  { label: "Mjerenje i dogovor", tone: "tone-3", src: hero3 },
  { label: "Namještaj po mjeri", tone: "tone-4", src: hero4 },
];

// Repeat count for the infinite marquee below — enough copies per half so
// even a very wide/ultrawide viewport never shows a gap before the loop
// point. The track renders TWO of these groups back to back and animates
// exactly -50%, so as long as one group's real width covers the widest
// viewport this site needs to support, the loop is seamless.
const marqueeRepeat = Array.from({ length: 6 });
---

<BaseLayout
  title="Kompetentnost kojoj vjeruješ"
  description="Ivertim — precizna obrada pločastog materijala, od uslužnog rezanja do namještaja po mjeri, iz Prijedora."
>
  <Header />
  <main>
    <section class="section hero" aria-labelledby="hero-heading" data-reveal>
      <div class="hero-carousel" role="img" aria-label="Faze saradnje sa Ivertim-om — uslužno rezanje, kantovanje i bušenje, mjerenje i dogovor, namještaj po mjeri">
        {
          heroSlides.map((slide, index) => (
            <div class:list={["hero-slide", slide.tone]} style={`animation-delay: ${index * 6}s`}>
              <Image class="hero-slide-img" src={slide.src} alt="" width={1600} height={900} />
              <img class="hero-slide-shape" src="/images/signature-shape-inverse.svg" alt="" aria-hidden="true" />
            </div>
          ))
        }
      </div>
      <div class="hero-scrim" aria-hidden="true"></div>

      <div class="hero-content">
        <div class="hero-bottom">
          <h1 id="hero-heading" class="hero-heading">Precizna obrada pločastog materijala — od uslužnog rezanja do namještaja po mjeri.</h1>
          <div class="hero-copy">
            <p class="lead">
              Nekome treba samo precizno isječen i okantovan materijal, nekome kompletno rješenje po mjeri prostora. Zato ne počinjemo od gotovog proizvoda, već od razumijevanja onoga što vam zaista treba.
            </p>
            <div class="hero-actions">
              <a class="cta-secondary" href="/proces-saradnje">Pogledajte kako radimo</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="section about" aria-labelledby="about-heading" data-reveal>
      <div class="about-stats">
        <div class="about-stats-header">
          <img class="about-stats-mark" src="/images/logo-mark-inverse.svg" alt="" aria-hidden="true" />
          <p class="about-stats-tagline">Kompetentnost kojoj vjeruješ</p>
        </div>

        <div class="about-stats-counters">
          <div class="counter">
            <p class="counter-value" data-counter data-target="16" data-suffix="+">16+</p>
            <p class="counter-label">Godina rada</p>
          </div>
          <div class="counter">
            <p class="counter-value" data-counter data-target="500" data-suffix="+">500+</p>
            <p class="counter-label">Zadovoljnih klijenata</p>
          </div>
        </div>
      </div>

      <div class="about-text">
        <p class="eyebrow">Ko smo mi</p>
        <h2 id="about-heading" class="text-reveal">Preuzimamo odgovornost za cijeli proces</h2>
        <p class="section-lead">
          Ivertim nije samo proizvođač namještaja. Naša vrijednost je sposobnost da preuzmemo odgovornost za cijeli proces — od prvog razgovora i mjerenja, do prijedloga, proizvodnje i, gdje je potrebno, montaže i postprodajne brige.
        </p>
      </div>
    </section>

    <section class="section" aria-labelledby="process-heading" data-reveal>
      <h2 id="process-heading" class="text-reveal">Proces postoji da bi neizvjesnost pretvorio u sigurnost.</h2>
      <p class="section-lead">
        Svaki korak postoji kako bi odluke bile donesene na vrijeme, a projekat tekao jasno i bez nepotrebnih iznenađenja.
      </p>
      <a class="link-cta" href="/proces-saradnje">Pogledajte cijeli proces →</a>
    </section>

    <!-- Replaces the old Projekti-teaser section (owner's ask, 2026-09-13
         — compatto.gr's "Why Choose Compatto" reference): Projekti already
         has its own navbar link for whoever wants to browse it, so this
         slot now highlights Ivertim's own real differentiators instead of
         duplicating that link. Structural reference only (the asymmetric
         "bento" grid), not a literal copy — colors/gradients stay within
         this site's own locked palette (no decorative gradient blobs like
         compatto's own cards use), and the copy is 100% real, confirmed
         facts already established elsewhere in this project (own factory,
         two-service model, the 16+/500+ stats), nothing fabricated. -->
    <section class="section benefits" aria-labelledby="benefits-heading" data-reveal>
      <p class="eyebrow">Zašto Ivertim</p>
      <h2 id="benefits-heading" class="text-reveal">Ono što stoji iza svakog projekta.</h2>
      <p class="section-lead">Nije u obećanjima — vidi se u opremi, procesu i ljudima koji stoje iza njih.</p>

      <div class="bento">
        <div class="bento-card bento-card--factory">
          <h3>Sopstvena fabrika</h3>
          <p>Rezanje, kantovanje i bušenje radimo u vlastitoj fabrici u Prijedoru, na sopstvenim CNC mašinama — bez čekanja na podizvođače.</p>
        </div>

        <div class="bento-card bento-card--process">
          <h3>Jasan proces</h3>
          <p>Slušamo, mjerimo, predlažemo. Svaka odluka se donosi na vrijeme, a projekat teče bez iznenađenja.</p>
        </div>

        <div class="bento-card bento-card--dark">
          <h3>Dva servisa, jedan pouzdan partner</h3>
          <p>Bilo da vam treba samo precizno rezanje i kantovanje ili kompletno rješenje po mjeri, radimo na istoj adresi, sa istim timom — 16+ godina rada, 500+ zadovoljnih klijenata.</p>
        </div>

        <div class="bento-card bento-card--image">
          <Image class="bento-card-img" src={benefitsImage} alt="" width={800} height={500} />
          <div class="bento-card-scrim" aria-hidden="true"></div>
          <div class="bento-card-content">
            <h3>Isti standard preciznosti, od materijala do gotovog rješenja</h3>
            <p>Od uslužnog rezanja za manje radionice do namještaja po mjeri za domove i poslovne prostore — pristup se ne mijenja.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="section marquee-section" aria-hidden="true">
      <div class="marquee-track">
        <div class="marquee-group">
          {
            marqueeRepeat.map(() => (
              <>
                <span class="marquee-text">Kompetentnost kojoj vjeruješ</span>
                <span class="marquee-mark" />
              </>
            ))
          }
        </div>
        <div class="marquee-group">
          {
            marqueeRepeat.map(() => (
              <>
                <span class="marquee-text">Kompetentnost kojoj vjeruješ</span>
                <span class="marquee-mark" />
              </>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section closing-wrap" aria-labelledby="closing-heading" data-reveal>
      <div class="closing gradient-brand">
        <h2 id="closing-heading" class="text-reveal">Prvi korak je razgovor.</h2>
        <p class="section-lead closing-lead">
          Svaki projekat počinje drugačije, ali uvijek istim prvim korakom. Razgovor nam pomaže da razumijemo vaš prostor, potrebe i očekivanja kako bismo zajedno pronašli najbolje rješenje.
        </p>
        <p class="reassurance">Nema obaveze. Nema pritiska. Samo razgovor.</p>
        <a class="cta cta-on-gradient" href="/kontakt">Razgovarajmo</a>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<script>
  // Count-up for the two business stats in the dark "about" card — starts
  // once the card scrolls into view, not on page load, since it's well
  // below the fold. HTML already carries the real final value (e.g.
  // "16+") so a no-JS visitor still sees the correct number; JS only
  // resets to "0" right before animating it back up.
  const counters = document.querySelectorAll<HTMLElement>("[data-counter]");
  const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  function animateCounter(el: HTMLElement) {
    const target = Number(el.dataset.target ?? "0");
    const suffix = el.dataset.suffix ?? "";
    const duration = 1400;
    const start = performance.now();

    function tick(now: number) {
      const progress = Math.min((now - start) / duration, 1);
      const eased = 1 - Math.pow(1 - progress, 3);
      el.textContent = `${Math.round(target * eased)}${suffix}`;
      if (progress < 1) requestAnimationFrame(tick);
    }

    requestAnimationFrame(tick);
  }

  if (counters.length && !prefersReducedMotion && "IntersectionObserver" in window) {
    counters.forEach((el) => {
      el.textContent = "0";
    });

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            animateCounter(entry.target as HTMLElement);
            observer.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.6 }
    );
    counters.forEach((el) => observer.observe(el));
  }
  // Reduced motion (or no IntersectionObserver support): leave the
  // server-rendered final values in place, animate nothing.
</script>

<style>
  /* max-width now lives on .section itself (below), not on <main> — .hero
     needs to render wider than the other sections (see .hero's own
     comment), which isn't possible while it's a child of a parent whose
     own box is already capped at container-xl. Every other section
     replicates the old look exactly (same cap, same centering). */
  main {
    width: 100%;
  }

  .section {
    max-width: var(--container-xl);
    margin: 0 auto;
    padding: var(--space-3xl) var(--container-padding);
    border-top: var(--border-1) solid var(--border-subtle);
  }

  /* Hero now IS the photo — text overlays it directly (owner's ask,
     2026-09-08), instead of a separate image block below the text.
     .hero-carousel/.hero-scrim are absolutely positioned (inset:0) so
     they always cover whatever height .hero ends up being; .hero-content
     stays in normal flow as the flex container's one real child, so
     min-height is only a floor, never a cap — on mobile, where the H1
     wraps to more lines, .hero grows taller instead of clipping text
     against a fixed box (a real bug caught here: the first version made
     .hero-content position:absolute + inset:0 too, which clipped the
     heading's top line on narrow viewports once it wrapped past what
     560px could fit). */
  .hero {
    position: relative;
    max-width: none;
    border-top: none;
    padding: 0;
    border-radius: var(--radius-4);
    overflow: hidden;
    min-height: 560px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    /* Gap under the pill, not an overlap (owner's ask, 2026-09-11,
       reversing the 2026-09-08 overlap below) — now that the navbar is
       translucent (color-mix "milk glass", Header.astro), sitting it
       directly against the hero's own busy photo/scrim read as muddy
       rather than showing a clean hint of what's behind. Same value as
       the pill's own top margin (space-lg) so the composition stays
       visually balanced: viewport-to-pill and pill-to-hero are now the
       same gap. Applies on both breakpoints — mobile previously had no
       gap at all (0, implicit), not an overlap, but the same "give the
       translucent pill room to breathe" reasoning applies there too. */
    margin-top: var(--space-lg);
    /* Side insets match the floating navbar's own margin exactly
       (Header.astro's .site-header — container-padding on mobile,
       space-xl on desktop) instead of the container-xl cap every other
       .section keeps — owner's ask 2026-09-12, comparing a compatto.gr
       screenshot against Ivertim's own: past ~1344px viewport the old
       centered-and-capped hero read narrower than the navbar floating
       above it, the opposite of compatto's wider, closer-to-the-edge
       hero photo. `max-width: none` above opts this one section out of
       .section's shared cap; these margins (not a vw-based "breakout"
       trick, which risks a scrollbar-width overflow) are what actually
       produce the width — .hero can be wider than its siblings now that
       <main> itself is uncapped (see the shared `main`/`.section` rule
       above). */
    margin-left: var(--container-padding);
    margin-right: var(--container-padding);
  }

  @media (min-width: 768px) {
    .hero {
      min-height: 680px;
      margin-left: var(--space-xl);
      margin-right: var(--space-xl);
    }
  }

  .hero-content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    padding: var(--space-2xl) var(--container-padding) var(--space-xl);
  }

  /* Heading bottom-left, description+CTAs as a narrower block bottom-
     right — compatto.gr's own hero split (owner-referenced screenshots,
     2026-09-08), stacked on mobile like every other two-column pattern
     on this site. */
  .hero-bottom {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  @media (min-width: 768px) {
    .hero-bottom {
      flex-direction: row;
      /* Top-aligned, not bottom-aligned — the heading wraps to more
         lines than the copy column, so bottom-aligning left their tops
         mismatched (heading starting visibly lower). Owner's ask,
         2026-09-08. */
      align-items: flex-start;
      justify-content: space-between;
      gap: var(--space-2xl);
    }

    .hero-heading {
      flex: 1 1 auto;
    }

    .hero-copy {
      flex: 0 0 340px;
      max-width: 340px;
    }
  }

  /* Text now sits on a photo, not the page background — override the
     default dark-on-light colors to light-on-dark, same pattern already
     used for .closing-lead/.reassurance on the gradient CTA section. */
  .hero-content h1 {
    color: var(--text-inverse);
  }

  .hero-content .lead {
    color: rgb(255 255 255 / 0.85);
  }

  h1 {
    font-size: var(--text-display-sm-size-fluid);
    line-height: var(--text-display-sm-leading);
    font-weight: var(--text-display-sm-weight);
    letter-spacing: var(--text-display-sm-tracking);
    max-width: var(--content-max);
  }

  /* No top margin here — .lead used to stack directly under the H1 in
     one column; now it sits in its own .hero-copy column, bottom-aligned
     alongside the heading rather than below it. */
  .lead {
    max-width: var(--content-max);
    font-size: var(--text-body-lg-size);
    line-height: var(--text-body-lg-leading);
    color: var(--text-secondary);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-lg);
    margin-top: var(--space-xl);
  }

  /* ---------- Hero carousel: pure CSS crossfade, no JS ----------
     The carousel is now the hero's own background layer (owner's ask,
     2026-09-08) — it fills .hero completely (inset:0) instead of being
     its own sized box; .hero's min-height above is what actually sets
     how tall the photo reads as. */
  .hero-carousel {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero-slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    animation: hero-slide-fade 24s infinite;
  }

  /* Tone gradients now sit as a fallback background (visible only while
     the image loads, or if it ever fails) rather than the visible
     surface — the real image covers the slide on top of it. */
  .hero-slide.tone-1 {
    background: linear-gradient(135deg, var(--accent-500), var(--accent-700));
  }
  .hero-slide.tone-2 {
    background: linear-gradient(135deg, var(--accent-600), var(--accent-800));
  }
  .hero-slide.tone-3 {
    background: linear-gradient(135deg, var(--accent-800), var(--accent-950));
  }
  .hero-slide.tone-4 {
    background: linear-gradient(135deg, var(--accent-700), var(--accent-900));
  }

  .hero-slide-img {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* One static scrim for the whole hero, not a per-slide ::after — the
     H1/lead/CTA block now needs to stay readable continuously, including
     mid-crossfade when two photos briefly overlap, so this can't be tied
     to any single slide's own opacity animation. Strongest at the bottom
     where the text sits, fading out toward the top so the photo itself
     still reads clearly higher up. */
  .hero-scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(to top, rgb(0 0 0 / 0.8) 0%, rgb(0 0 0 / 0.35) 45%, rgb(0 0 0 / 0) 75%);
  }

  /* Signature Shape corner accents always sit bottom-left, bleeding
     across the edge rather than staying fully inset — locked rule,
     2026-09-05 (see docs/09 - Signature System.md §Cards). Was
     top-right; mirrored in place (top/right → bottom/left, same
     magnitudes) rather than re-deriving new offsets.

     Sized off height, not width (fixed same day) — .hero-carousel has
     a fixed 320px height but a fluid width (full-width single-column
     below 768px, narrower grid column above it), so a width-relative
     size made the image's own rendered size swing wildly with viewport
     width. At ~700px wide specifically, width:65% produced an image
     taller than the 320px box, clipping straight through the middle of
     the swirl instead of bleeding cleanly off one edge — confirmed by
     measuring the image's rendered box at several widths. Tying the
     size to the container's stable height keeps the shape's own size
     constant regardless of viewport width. */
  .hero-slide-shape {
    position: absolute;
    z-index: 2;
    bottom: -15%;
    left: -10%;
    height: 65%;
    width: auto;
    opacity: 0.16;
  }

  /* True crossfade, not sequential fade-to-nothing-then-fade-in: each
     slide's fade-out (20.83%–29.17% of its own 24s timeline = seconds
     5–7) deliberately overlaps the next slide's fade-in (0%–4.17% =
     seconds 0–1), since the next slide's delay lands its own 0% exactly
     at second 6 of this slide's timeline. That shared 1s window is where
     one slide is finishing its fade down while the next is finishing its
     fade up, so there's always visible photo on screen — never a moment
     where every slide is near-zero at once (the old 3%/22%/25% timing
     ended this slide's fade-out exactly when the next one's fade-in
     began, instead of overlapping it). */
  @keyframes hero-slide-fade {
    0%,
    100% {
      opacity: 0;
    }
    4.17%,
    20.83% {
      opacity: 1;
    }
    29.17% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-slide {
      animation: none;
      opacity: 0;
    }
    .hero-slide:first-child {
      opacity: 1;
    }
  }

  h2 {
    font-size: var(--text-h2-size-fluid);
    line-height: var(--text-h2-leading);
    font-weight: var(--text-h2-weight);
    letter-spacing: var(--text-h2-tracking);
    max-width: var(--content-max);
  }

  .section-lead {
    margin-top: var(--space-md);
    max-width: var(--content-max);
    font-size: var(--text-body-lg-size);
    line-height: var(--text-body-lg-leading);
    color: var(--text-secondary);
  }

  /* Rounded-rectangle "mark" treatment — see Header.astro's .cta for the
     full rationale (2026-09-05, owner-specified: echo the logo mark). */
  /* Hover inverts the button — see Header.astro's .cta for the full
     rationale (2026-09-13, owner-specified, compatto.gr reference):
     border/fill swap and everything moves on motion-slower, not
     motion-fast. */
  .cta {
    position: relative;
    z-index: 0;
    overflow: hidden;
    display: inline-flex;
    padding: var(--space-sm) calc(var(--space-xl) * 2);
    border: var(--border-1) solid transparent;
    color: var(--action-primary-text);
    border-radius: var(--radius-2);
    box-shadow: var(--shadow-1);
    text-decoration: none;
    font-weight: var(--text-label-lg-weight);
    transition: border-color var(--motion-slower) var(--ease-out), color var(--motion-slower) var(--ease-out);
  }

  /* Signature Shape as a genuine cutout — see Header.astro's .cta::before
     for the full rationale (2026-09-05, owner-specified): it mirrors how
     the shape works inside the logo mark itself (negative space, not an
     inked overlay), via a two-mask XOR trick that cuts a shape-sized
     hole through this ::before's own fill, revealing whatever's actually
     behind the button.

     Corner touch, same day: tried cropping the mark further toward the
     corner (mask-size 90%, position left top) — reverted; it turned the
     recognizable curve into a flat, blocky rectangle (owner: "ne valja"),
     worse than the small gap it was meant to fix. Back to auto 62%/left
     bottom, which keeps the shape looking like itself.

     Bottom-edge bleed, 2026-09-05: see Header.astro's .cta::before for
     the full story — nudged this layer's mask-position from `left bottom`
     to `0 calc(100% + 4px)` so the mark's existing ink bleeds a few px
     past the button's true bottom edge instead of landing exactly on it,
     closing a visible seam the live mask rasterization left behind. */
  .cta::before {
    content: "";
    position: absolute;
    z-index: -1;
    inset: 0;
    border-radius: inherit;
    background: var(--gradient-button);
    opacity: 1;
    transition: opacity var(--motion-slower) var(--ease-out);
    -webkit-mask-image: linear-gradient(#000 0 0), url("/images/signature-shape.svg");
    -webkit-mask-repeat: no-repeat, no-repeat;
    -webkit-mask-position: 0 0, 0 calc(100% + 4px);
    -webkit-mask-size: 100% 100%, auto 62%;
    -webkit-mask-composite: xor;
    mask-image: linear-gradient(#000 0 0), url("/images/signature-shape.svg");
    mask-repeat: no-repeat, no-repeat;
    mask-position: 0 0, 0 calc(100% + 4px);
    mask-size: 100% 100%, auto 62%;
    mask-composite: exclude;
  }

  /* Fill fades via `opacity`, not by swapping `background` to transparent
     — see Header.astro's .cta:hover::before for the full rationale
     (2026-09-13: fixes a real hover-speed mismatch against
     .cta-secondary, same root cause as that button's own 2026-09-12
     "flash" bug — background-image can't be smoothly interpolated). */
  .cta:hover::before,
  .cta:active::before {
    opacity: 0;
  }

  /* Border + text now carry the color the fill used to — see
     Header.astro's .cta:hover for the full rationale, including why
     there's no lift/press transform or shadow here (owner's follow-up
     ask, 2026-09-13): just the slow color change, nothing else moves. */
  .cta:hover {
    border-color: var(--action-primary-hover);
    color: var(--action-primary-hover);
  }

  .cta:active {
    border-color: var(--action-primary-active);
    color: var(--action-primary-active);
  }

