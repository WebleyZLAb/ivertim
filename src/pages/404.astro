---
import PageLayout from "../layouts/PageLayout.astro";
---

<PageLayout title="Stranica nije pronađena" description="Stranica koju tražite ne postoji ili je premještena.">
  <section class="not-found" data-reveal>
    <p class="eyebrow">404</p>
    <h1>Ova stranica ne postoji.</h1>
    <p class="lead">
      Možda je link zastario ili je stranica premještena. Vratite se na početnu ili nam se javite ako tražite nešto konkretno.
    </p>
    <div class="actions">
      <a class="cta" href="/">Nazad na početnu</a>
      <a class="cta-secondary" href="/kontakt">Razgovarajmo</a>
    </div>
  </section>
</PageLayout>

<style>
  .not-found {
    padding-top: var(--space-2xl);
    padding-bottom: var(--space-4xl);
    max-width: var(--content-max);
  }

  .eyebrow {
    font-size: var(--text-overline-size);
    font-weight: var(--text-overline-weight);
    letter-spacing: var(--text-overline-tracking);
    text-transform: uppercase;
    color: var(--text-accent);
  }

  h1 {
    margin-top: var(--space-sm);
    font-size: var(--text-h1-size-fluid);
    line-height: var(--text-h1-leading);
    font-weight: var(--text-h1-weight);
    letter-spacing: var(--text-h1-tracking);
  }

  .lead {
    margin-top: var(--space-lg);
    font-size: var(--text-body-lg-size);
    line-height: var(--text-body-lg-leading);
    color: var(--text-secondary);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-lg);
    margin-top: var(--space-xl);
  }

  /* Rounded-rectangle "mark" treatment — see Header.astro's .cta for the
     full rationale (2026-09-05, owner-specified: echo the logo mark). */
  .cta {
    position: relative;
    overflow: hidden;
    display: inline-flex;
    padding: var(--space-sm) calc(var(--space-xl) * 2);
    background: var(--gradient-button);
    color: var(--action-primary-text);
    border-radius: var(--radius-2);
    box-shadow: var(--shadow-1);
    text-decoration: none;
    font-weight: var(--text-label-lg-weight);
    transition: background var(--motion-fast) var(--ease-out);
  }

  /* Shape sized/cropped to the actual signature-shape-inverse.svg viewBox
     (188.16 / 193.02, not the non-inverse file's 169.44 / 179.65 — the two
     files' canvases aren't the same size even though the mark itself is)
     — matching aspect-ratio + an oversized background-size crops the
     source file's own internal margin so the mark bleeds flush to/past
     the button's edge instead of sitting inset from it. Shrunk slightly
     (top 30%→38%). The button's padding grew by one space-xl on BOTH
     sides (not just the shape side) — inline-flex with a single item
     shrink-wraps its box exactly to padding+content, so justify-content
     has no slack to center into; asymmetric-only padding just left the
     label pinned near the mark with dead space after it. Symmetric
     padding keeps the label naturally centered while still widening the
     left side enough to give the mark real room. */
  .cta::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: 0;
    top: 38%;
    aspect-ratio: 188.16 / 193.02;
    background: url("/images/signature-shape-inverse.svg") no-repeat center / 115%;
    opacity: 0.22;
    pointer-events: none;
  }

  .cta:hover {
    background: var(--gradient-button-hover);
  }

  .cta:active {
    background: var(--gradient-button-active);
  }

  /* Outline treatment, 2026-09-05 — see index.astro's .cta-secondary for
     the full rationale (gradient border via the two-layer background trick). */
  .cta-secondary {
    display: inline-flex;
    align-items: center;
    padding: var(--space-sm) var(--space-xl);
    border: 2px solid transparent;
    border-radius: var(--radius-2);
    background:
      linear-gradient(var(--bg-primary), var(--bg-primary)) padding-box,
      var(--gradient-button) border-box;
    color: var(--action-primary);
    text-decoration: none;
    font-weight: var(--text-label-lg-weight);
    transition: background var(--motion-fast) var(--ease-out), color var(--motion-fast) var(--ease-out);
  }

  .cta-secondary:hover {
    background:
      linear-gradient(var(--bg-primary), var(--bg-primary)) padding-box,
      var(--gradient-button-hover) border-box;
    color: var(--action-primary-hover);
  }

  .cta-secondary:active {
    background:
      linear-gradient(var(--bg-primary), var(--bg-primary)) padding-box,
      var(--gradient-button-active) border-box;
    color: var(--action-primary-active);
  }
</style>
