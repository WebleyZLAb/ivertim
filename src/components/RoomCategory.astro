---
interface Props {
  category: string;
  tagline: string;
  lead: string;
  side?: "left" | "right";
  tone?: "1" | "2" | "3" | "4" | "5" | "6";
}

const { category, tagline, lead, side = "left", tone = "1" } = Astro.props;
---

<div class:list={["room", `room--${side}`]} data-reveal>
  <div class:list={["room-visual", `room-visual--tone-${tone}`]}>
    <img class="room-visual-shape" src="/images/signature-shape-inverse.svg" alt="" aria-hidden="true" />
    <p class="room-visual-note">Fotografija stiže uskoro</p>
  </div>
  <div class="room-text">
    <p class="eyebrow">{category}</p>
    <h3>{tagline}</h3>
    <p class="lead">{lead}</p>
  </div>
</div>

<style>
  .room {
    display: grid;
    gap: var(--space-lg);
    align-items: center;
    padding: var(--space-xl) 0;
    border-top: var(--border-1) solid var(--border-subtle);
  }

  .room-visual {
    position: relative;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-4);
    overflow: hidden;
    display: flex;
    align-items: flex-end;
    padding: var(--space-md);
  }

  .room-visual--tone-1 {
    background: linear-gradient(135deg, var(--accent-500), var(--accent-700));
  }
  .room-visual--tone-2 {
    background: linear-gradient(135deg, var(--accent-600), var(--accent-800));
  }
  .room-visual--tone-3 {
    background: linear-gradient(135deg, var(--accent-400), var(--accent-600));
  }
  .room-visual--tone-4 {
    background: linear-gradient(135deg, var(--accent-700), var(--accent-900));
  }
  .room-visual--tone-5 {
    background: linear-gradient(135deg, var(--accent-800), var(--accent-950));
  }
  .room-visual--tone-6 {
    background: linear-gradient(135deg, var(--accent-500), var(--accent-900));
  }

  /* Signature Shape corner accents always sit bottom-left, bleeding
     across the edge rather than staying fully inset — locked rule,
     2026-09-05 (see docs/09 - Signature System.md §Cards). Was
     top-right; mirrored in place (top/right → bottom/left, same
     magnitudes) rather than re-deriving new offsets. */
  .room-visual-shape {
    position: absolute;
    bottom: -12%;
    left: -8%;
    width: 55%;
    height: auto;
    opacity: 0.16;
  }

  .room-visual-note {
    position: relative;
    font-size: var(--text-caption-size);
    color: rgb(255 255 255 / 0.75);
  }

  .eyebrow {
    font-size: var(--text-overline-size);
    font-weight: var(--text-overline-weight);
    letter-spacing: var(--text-overline-tracking);
    text-transform: uppercase;
    color: var(--text-accent);
    margin-bottom: var(--space-xs);
  }

  .room-text h3 {
    /* Reset the parent page's .prose h3 margin-top — this component
       controls its own spacing via the .room grid/padding. */
    margin-top: 0;
    font-size: var(--text-h4-size);
    line-height: var(--text-h4-leading);
    font-weight: var(--text-h4-weight);
    color: var(--text-primary);
  }

  .room-text .lead {
    margin-top: var(--space-sm);
    color: var(--text-secondary);
    font-size: var(--text-body-md-size);
    line-height: var(--text-body-md-leading);
  }

  @media (min-width: 768px) {
    .room {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-2xl);
    }

    .room--right .room-visual {
      order: 2;
    }

    .room--right .room-text {
      order: 1;
    }
  }
</style>
