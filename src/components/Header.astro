---
const navItems = [
  { href: "/usluge", label: "Usluge" },
  { href: "/projekti", label: "Projekti" },
  { href: "/proces-saradnje", label: "Proces saradnje" },
  { href: "/blog", label: "Blog" },
];
---

<header class="site-header" data-reveal>
  <a class="logo" href="/" aria-label="Ivertim — početna">
    <img src="/images/logo-horizontal.svg" alt="Ivertim" width="140" height="21" />
  </a>

  <details class="nav-disclosure">
    <summary aria-label="Otvori meni">
      <svg class="menu-shape" viewBox="0 0 169.44 179.65" width="22" height="22" fill="currentColor" aria-hidden="true">
        <path d="M166.28,176.36v.04h-42.56c-.43-19.55.89-36.82-.65-56.2-2.94-37.28-32.7-69.48-69.95-73.34-18.21-1.9-34.58-.07-52.91-.75V3.48c22.12.49,42.22-1.16,64.44.62,53.74,4.3,96.65,49.29,101.01,103.04,1.91,23.67.08,45.37.62,69.22Z" />
      </svg>
    </summary>
  </details>

  <nav aria-label="Glavna navigacija">
    <a class="nav-logo" href="/" aria-label="Ivertim — početna">
      <img src="/images/logo-horizontal.svg" alt="Ivertim" width="140" height="21" />
    </a>
    <ul>
      {
        navItems.map((item) => (
          <li>
            <a href={item.href}>{item.label}</a>
          </li>
        ))
      }
    </ul>
    <a class="cta cta-mobile" href="/kontakt">Razgovarajmo</a>
  </nav>

  <a class="cta cta-desktop" href="/kontakt">Razgovarajmo</a>
</header>

<script>
  const disclosure = document.querySelector<HTMLDetailsElement>(".nav-disclosure");
  const summary = disclosure?.querySelector("summary");

  disclosure?.addEventListener("toggle", () => {
    summary?.setAttribute("aria-label", disclosure.open ? "Zatvori meni" : "Otvori meni");
  });
</script>

<style>
  /* Sticky on both breakpoints (owner's ask, 2026-09-10) — stays pinned
     to the viewport top on scroll instead of scrolling away with the
     page. `[data-reveal]` (global.css) gives it the same gentle
     fade+slide-up entrance every other major section already uses on
     load ("lagano izađe") — it's the first thing on the page, so the
     shared IntersectionObserver (BaseLayout.astro) fires for it almost
     immediately rather than waiting for a scroll. */
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-sticky);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    padding: var(--space-md) var(--container-padding);
    border-bottom: var(--border-1) solid var(--border-subtle);
    background: var(--bg-primary);
    /* "Milk glass" soft edge (owner's ask, 2026-09-11), applied on both
       breakpoints' pill treatment below — the owner's own term for a
       reference navbar effect, explicitly distinguished from banned
       glassmorphism: no `backdrop-filter` blurring whatever sits behind
       it, just the pill's OWN bottom edge dissolving into a gradient
       instead of cutting off with a hard line, via `mask-image` (masks
       don't blur content, they fade the element's own paint — bg,
       border, shadow — to transparent, so whatever's genuinely behind
       the pill shows through in the fade, not a guessed color). 60%
       tested live against three different backgrounds (hero photo, a
       dark about-section, the plain page background) before landing
       here — 85% read as barely-there, 30% dissolved distractingly far
       into the pill's own content; 60% keeps the logo/nav fully solid
       and only softens the lower third. */
    mask-image: linear-gradient(to bottom, black 60%, transparent 100%);
    -webkit-mask-image: linear-gradient(to bottom, black 60%, transparent 100%);
  }

  .logo {
    display: inline-flex;
    align-items: center;
    line-height: 0;
  }

  .logo img {
    height: 22px;
    width: auto;
  }

  /* Second logo lockup, mobile-sidebar-only (see the mobile media query
     below) — the real header logo sits behind the sidebar once it's
     open (fixed, full-height panel), so the sidebar carries its own
     copy at its own top instead of relying on the one in the bar. */
  .nav-logo {
    display: none;
  }

  .nav-logo img {
    height: 20px;
    width: auto;
  }

  /* Rounded-rectangle "mark" treatment (2026-09-05, owner-specified):
     same button colors as before, but shaped to echo the logo mark —
     a generous rounded-rect instead of a full pill, a subtle lift
     shadow, and a faint Signature Shape watermark in the corner. */
  .cta {
    position: relative;
    z-index: 0;
    overflow: hidden;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-sm) calc(var(--space-lg) + var(--space-xl));
    color: var(--action-primary-text);
    border-radius: var(--radius-2);
    box-shadow: var(--shadow-1);
    text-decoration: none;
    font-size: var(--text-label-md-size);
    font-weight: var(--text-label-md-weight);
    transition: transform var(--motion-fast) var(--ease-out), box-shadow var(--motion-fast) var(--ease-out);
  }

  /* Signature Shape as a genuine cutout, 2026-09-05 (owner-specified) —
     mirrors how the shape actually works inside the logo mark itself:
     it's negative space, not an inked overlay, so whatever sits behind
     the mark shows through. The gradient fill lives on this ::before
     (not on .cta directly) so a two-layer mask can cut a shape-sized
     hole through JUST the fill — `exclude`/`xor` is the standard
     two-mask XOR trick (a full opaque rect + the shape, cancelled where
     they overlap) — leaving the real page background visible through
     the hole. `z-index:-1` keeps it behind the label; `.cta`'s own
     `z-index:0` gives it a local stacking context to be scoped to
     instead of leaking into the page's. Uses the plain (non-inverse)
     signature-shape.svg — its viewBox is already tightly cropped to the
     mark with no internal margin to fight, unlike the inverse file used
     for the old opaque-watermark version.

     Corner touch, same day: tried cropping the mark further toward the
     corner (mask-size 90%, position left top) — reverted; it turned the
     recognizable curve into a flat, blocky rectangle (owner: "ne valja"),
     worse than the small gap it was meant to fix. Back to auto 62%/left
     bottom, which keeps the shape looking like itself.

     Bottom-edge bleed, 2026-09-05 (owner caught this on the live button,
     zoomed in): even with auto 62%/left bottom, a thin sliver of the
     button's own fill was visibly showing between the mark's lowest ink
     and the button's true bottom edge — measured via canvas pixel
     sampling of the actual render: the shape's ink there is only an
     ~8px-wide foot (not the full width), and while it mathematically
     reaches the last pixel row, the live mask rasterization still left a
     visible seam, reading exactly like an unwanted border line. Same
     "bleed past the edge" principle already locked for card corner
     accents (docs/09 §Cards) — nudged the second mask layer's position
     from `left bottom` to `0 calc(100% + 4px)` so the mark's existing
     bottom ink is pushed a few px past the button's own edge instead of
     landing exactly on it. This only crops an imperceptible sliver off
     the mark's own anti-aliased tip — no resize, no distortion, no
     rotation, source SVG untouched. */
  .cta::before {
    content: "";
    position: absolute;
    z-index: -1;
    inset: 0;
    border-radius: inherit;
    background: var(--gradient-button);
    transition: background var(--motion-fast) var(--ease-out);
    -webkit-mask-image: linear-gradient(#000 0 0), url("/images/signature-shape.svg");
    -webkit-mask-repeat: no-repeat, no-repeat;
    -webkit-mask-position: 0 0, 0 calc(100% + 4px);
    -webkit-mask-size: 100% 100%, auto 62%;
    -webkit-mask-composite: xor;
    mask-image: linear-gradient(#000 0 0), url("/images/signature-shape.svg");
    mask-repeat: no-repeat, no-repeat;
    mask-position: 0 0, 0 calc(100% + 4px);
    mask-size: 100% 100%, auto 62%;
    mask-composite: exclude;
  }

  .cta:hover::before {
    background: var(--gradient-button-hover);
  }

  .cta:active::before {
    background: var(--gradient-button-active);
  }

  /* Lift on hover, press back down on active — a neutral (uncolored)
     shadow step-up + a small upward nudge, not a color change, so it
     reads clearly without touching the locked no-colored-shadows rule.
     Same treatment on .cta-secondary for consistency (2026-09-05,
     owner-specified). */
  .cta:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-2);
  }

  .cta:active {
    transform: translateY(0);
    box-shadow: var(--shadow-1);
  }

  .cta:focus-visible {
    outline: none;
    box-shadow: var(--focus-default);
  }

  /* Desktop: plain nav row, no disclosure chrome. */
  nav[aria-label="Glavna navigacija"] {
    display: flex;
    align-items: center;
    gap: var(--space-xl);
  }

  nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-lg);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* :not(.cta) — real bug found 2026-09-10 (owner: mobile sidebar CTA
     text wasn't light): Astro's scoped-style pass appends the same
     `[data-astro-cid-...]` attribute selector to every simple selector
     in a rule, which doesn't preserve relative specificity — a 1-class
     selector like `.cta` becomes 2 specificity units (class+attribute),
     but a 2-element selector like `nav a` becomes 4 (2×element+attribute
     each). That inversion let this rule's --text-secondary beat .cta's
     own --action-primary-text on the mobile CTA specifically (only
     mobile, since .cta-desktop isn't a descendant of this <nav>),
     confirmed via the page's actual matched CSSOM rules, not guessed.
     Excluding .cta here is the correct fix either way — this rule was
     only ever meant to style the plain nav links, never the CTA button
     that happens to share the same <nav>. */
  nav a:not(.cta) {
    color: var(--text-secondary);
    text-decoration: none;
    font-size: var(--text-body-sm-size);
  }

  nav a:not(.cta):hover {
    color: var(--text-accent);
  }

  .nav-disclosure summary {
    list-style: none;
  }

  .nav-disclosure summary::-webkit-details-marker {
    display: none;
  }

  /* Single Signature Shape mark, no open/close icon swap — it just turns
     180° in place on toggle (2026-09-05, owner-specified). Was previously
     the logo mark (two paths) cross-fading to an X, a mismatch from the
     Signature-Shape intent recorded in CLAUDE.md's 2026-09-04 session
     notes — corrected here to the actual signature-shape.svg path. */
  .menu-shape {
    transition: transform var(--motion-slow) var(--ease-emphasized);
  }

  .nav-disclosure[open] .menu-shape {
    transform: rotate(180deg);
  }

  /* <nav> used to live *inside* <details>, relying on the browser's native
     open/closed behavior to show/hide it. Found via a Playwright test
     failure (2026-09-04): a <nav> nested inside a <details> flex ancestor
     computes a 0 max-content width in this browser's flexbox intrinsic-
     sizing algorithm, regardless of the <details>'s own `display` value —
     confirmed by moving <nav> out from under <details> as a plain sibling,
     which fixed it immediately. <nav> is now a sibling of <details>, shown
     on mobile via the `[open] + nav` selector below instead of natively. */
  .nav-disclosure {
    display: inline-flex;
    align-items: center;
  }

  .cta-mobile {
    display: none;
  }

  @media (min-width: 768px) {
    .nav-disclosure {
      display: none;
    }

    /* Floating navbar — referenced from compatto.gr's shape, with an
       added shadow so it reads as lifted/floating above the page
       (compatto's own doesn't have one — this is a deliberate addition,
       per owner request). Radius, 2026-09-05: no longer a full pill —
       owner asked it to echo the .cta button's roundedness instead of
       being its own shape. Matched by ratio, not by copying the
       button's raw 8px: radius-2 (8px) on a ~52px button is an 8/52
       ≈ 0.154 radius-to-height ratio; applying that same ratio to this
       bar's own ~76px height gives 0.154 × 76 ≈ 11.7px, which lands
       almost exactly on radius-3 (12px) — an existing token, not a new
       value.

       Sticky top offset matches the pill's own top margin (space-lg) —
       once scrolled far enough to stick, it keeps exactly the same gap
       from the viewport edge it had at rest, so there's no visible jump
       at the moment it starts sticking. */
    .site-header {
      position: sticky;
      top: var(--space-lg);
      z-index: var(--z-sticky);
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      margin: var(--space-lg) var(--space-xl) 0;
      padding: var(--space-sm) var(--space-lg) var(--space-sm) var(--space-xl);
      background: var(--surface-1);
      border-bottom: none;
      border-radius: var(--radius-3);
      box-shadow: var(--shadow-2);
    }

    /* Logo left, nav links centered independently of the CTA, CTA pinned
       to the far right edge — three distinct zones instead of grouping
       the nav and CTA together on the right. */
    .logo {
      grid-column: 1;
      justify-self: start;
    }

    nav[aria-label="Glavna navigacija"] {
      grid-column: 2;
      justify-self: center;
    }

    /* Owner's ask, 2026-09-05: desktop nav links felt too quiet — bumped
       from --text-body-sm (14px/400) to --text-label-lg (16px/500), an
       existing label-scale token pair (not a new value), scoped to
       desktop only so mobile's own nav panel is untouched. */
    nav[aria-label="Glavna navigacija"] a {
      font-size: var(--text-label-lg-size);
      font-weight: var(--text-label-lg-weight);
    }

    .cta-desktop {
      grid-column: 3;
      justify-self: end;
    }
  }

  /* Mobile: logo + toggle in the bar, full nav panel opens below it. */
  @media (max-width: 767px) {
    /* Squarish floating pill (owner's ask, 2026-09-11) — echoes the
       desktop pill instead of a flush full-width bar, via the same
       ratio-matching technique already used for the desktop pill's own
       radius (design-system/geometry.md): .cta is radius-2 (8px) at a
       ~52px height, an 8/52 ≈ 0.154 ratio. Measured this bar's actual
       rendered height at 68px (not guessed) — 0.154 × 68 ≈ 10.5px,
       landing closer to radius-3 (12px) than radius-2. Sticky top
       offset matches the margin-top (space-lg), same reasoning as the
       desktop pill — no visible jump the moment it starts sticking. */
    .site-header {
      top: var(--space-lg);
      margin: var(--space-lg) var(--container-padding) 0;
      padding: var(--space-sm) var(--space-lg);
      background: var(--surface-1);
      border-bottom: none;
      border-radius: var(--radius-3);
      box-shadow: var(--shadow-2);
    }

    .cta-desktop {
      display: none;
    }

    .nav-disclosure summary {
      position: relative;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 44px;
      height: 44px;
      color: var(--icon-primary);
      cursor: pointer;
      border-radius: var(--radius-2);
    }

    .nav-disclosure summary:focus-visible {
      outline: none;
      box-shadow: var(--focus-default);
    }

    /* Toggle now sits inside the floating pill itself (no longer needs
       to escape a full-height sidebar covering the whole viewport top —
       see the sidebar comment below), so it stays in normal flow;
       .site-header's own position:sticky already keeps it on screen. */
    .nav-disclosure[open] summary {
      z-index: var(--z-modal);
    }

    /* Floating card, not a full-height dropdown (owner's ask, 2026-09-11,
       superseding the 2026-09-10 full-height version) — starts below the
       pill instead of at the true viewport top, and stops short of the
       viewport bottom by the same gap, so it reads as a card floating
       under the pill rather than an edge-to-edge utility panel. Docked
       right, same side as the toggle, so the panel visually "unfurls"
       from the same spot you tapped — matches the pill's own top/side
       margins (space-lg) exactly so the two feel like one connected
       shape rather than two independently-placed floating objects.

       Corner radius: only the two corners facing the page content (left
       side) are rounded — the right edge stays flush/square against the
       viewport's own right edge, since conceptually the shape continues
       past it (same "half a rounded card peeking out" logic already
       used for the pill/button radius matching elsewhere in this file).
       radius-4 chosen over the pill's own radius-3: this card is taller
       than the pill, and a slightly larger radius reads better at that
       scale — kept to an existing token, not a new value.

       Width is intrinsic (max-content, capped at 85vw as a safety net on
       very narrow screens) rather than stretched edge-to-edge —
       align-items:flex-start keeps every child (logo, links, CTA) at its
       own natural width instead of stretching to fill, so the panel's
       width ends up exactly as wide as its widest piece of content plus
       the horizontal padding. Logo sits right under the top padding;
       links follow immediately after via .nav-logo's own margin-bottom
       (not the container gap, which would space every child evenly
       including before the CTA); the CTA is pushed down to the bottom
       edge with margin-top:auto instead of living in the natural flow
       gap — still the most thumb-reachable zone, just inset by the same
       small margin as the rest of the card now.

       Slide in/out, not an instant display:none/flex swap (owner's ask,
       2026-09-10: "mnogo nježniji easy in i out") — display can't be
       transitioned, so the panel now always renders (fixed, so it never
       affects document flow either way) and is moved off-screen via
       transform instead. `visibility` is transitioned alongside it with
       a 0s duration + delay so the panel (and its links/CTA) drop out
       of the tab order the instant it's fully off-screen on close, but
       become interactive immediately on open — `pointer-events` mirrors
       that so an off-screen click target can't be hit while hidden.
       Durations/easing follow design-system/motion.md's own mapping:
       drawer = motion-slow, entrance = ease-out, exit = ease-in. */
    nav[aria-label="Glavna navigacija"] {
      display: flex;
      position: fixed;
      top: calc(var(--space-lg) + 68px + var(--space-lg));
      right: var(--container-padding);
      /* Explicit height, not `bottom` + auto-height — found a second real
         bug 2026-09-11 alongside the transform/containing-block one
         above: even with a clean containing-block chain, this engine
         wasn't solving `height:auto` correctly from `top`+`bottom` on a
         `position:fixed; display:flex` element (computed to a bogus
         ~50px instead of filling to the bottom gap) — confirmed by
         setting an explicit height and watching it render correctly,
         where `bottom` alone did not. Sidesteps the auto-height instead
         of chasing why one specific combination of fixed+flex+top+bottom
         doesn't resolve height as it should. */
      height: calc(100dvh - (var(--space-lg) * 3) - 68px);
      width: max-content;
      max-width: 85vw;
      z-index: var(--z-overlay);
      flex-direction: column;
      align-items: flex-start;
      padding: var(--space-md) var(--space-lg) var(--space-xl);
      background: var(--surface-1);
      border: var(--border-1) solid var(--border-subtle);
      border-right: none;
      border-radius: var(--radius-4) 0 0 var(--radius-4);
      box-shadow: var(--shadow-2);
      overflow-y: auto;
      visibility: hidden;
      pointer-events: none;
      transform: translateX(100%);
      transition:
        transform var(--motion-slow) var(--ease-in),
        visibility 0s linear var(--motion-slow);
    }

    .nav-disclosure[open] + nav[aria-label="Glavna navigacija"] {
      visibility: visible;
      pointer-events: auto;
      transform: translateX(0);
      transition:
        transform var(--motion-slow) var(--ease-out),
        visibility 0s linear 0s;
    }

    @media (prefers-reduced-motion: reduce) {
      nav[aria-label="Glavna navigacija"] {
        transition: none;
      }
    }

    .nav-logo {
      display: inline-flex;
      margin-bottom: var(--space-lg);
    }

    nav ul {
      flex-direction: column;
      gap: var(--space-md);
    }

    .cta-mobile {
      display: inline-flex;
      justify-content: center;
      margin-top: auto;
    }
  }
</style>
