---
const navItems = [
  { href: "/usluge", label: "Usluge" },
  { href: "/projekti", label: "Projekti" },
  { href: "/proces-saradnje", label: "Proces saradnje" },
  { href: "/blog", label: "Blog" },
];
---

<header class="site-header">
  <a class="logo" href="/" aria-label="Ivertim — početna">
    <img src="/images/logo-horizontal.svg" alt="Ivertim" width="140" height="21" />
  </a>

  <details class="nav-disclosure">
    <summary aria-label="Otvori meni">
      <svg class="menu-shape" viewBox="0 0 169.44 179.65" width="22" height="22" fill="currentColor" aria-hidden="true">
        <path d="M166.28,176.36v.04h-42.56c-.43-19.55.89-36.82-.65-56.2-2.94-37.28-32.7-69.48-69.95-73.34-18.21-1.9-34.58-.07-52.91-.75V3.48c22.12.49,42.22-1.16,64.44.62,53.74,4.3,96.65,49.29,101.01,103.04,1.91,23.67.08,45.37.62,69.22Z" />
      </svg>
    </summary>
  </details>

  <nav aria-label="Glavna navigacija">
    <ul>
      {
        navItems.map((item) => (
          <li>
            <a href={item.href}>{item.label}</a>
          </li>
        ))
      }
    </ul>
    <a class="cta cta-mobile" href="/kontakt">Razgovarajmo</a>
  </nav>

  <a class="cta cta-desktop" href="/kontakt">Razgovarajmo</a>
</header>

<script>
  const disclosure = document.querySelector<HTMLDetailsElement>(".nav-disclosure");
  const summary = disclosure?.querySelector("summary");

  disclosure?.addEventListener("toggle", () => {
    summary?.setAttribute("aria-label", disclosure.open ? "Zatvori meni" : "Otvori meni");
  });
</script>

<style>
  .site-header {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    padding: var(--space-md) var(--container-padding);
    border-bottom: var(--border-1) solid var(--border-subtle);
    background: var(--bg-primary);
  }

  .logo {
    display: inline-flex;
    align-items: center;
    line-height: 0;
  }

  .logo img {
    height: 22px;
    width: auto;
  }

  /* Rounded-rectangle "mark" treatment (2026-09-05, owner-specified):
     same button colors as before, but shaped to echo the logo mark —
     a generous rounded-rect instead of a full pill, a subtle lift
     shadow, and a faint Signature Shape watermark in the corner. */
  .cta {
    position: relative;
    overflow: hidden;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-sm) var(--space-lg);
    background: var(--gradient-button);
    color: var(--action-primary-text);
    border-radius: var(--radius-4);
    box-shadow: var(--shadow-1);
    text-decoration: none;
    font-size: var(--text-label-md-size);
    font-weight: var(--text-label-md-weight);
    transition: background var(--motion-fast) var(--ease-out);
  }

  .cta::after {
    content: "";
    position: absolute;
    right: 0;
    bottom: 0;
    top: 30%;
    aspect-ratio: 169.44 / 179.65;
    background: url("/images/signature-shape-inverse.svg") no-repeat center / contain;
    opacity: 0.22;
    pointer-events: none;
  }

  .cta:hover {
    background: var(--gradient-button-hover);
    color: var(--action-primary-text);
  }

  .cta:active {
    background: var(--gradient-button-active);
  }

  .cta:focus-visible {
    outline: none;
    box-shadow: var(--focus-default);
  }

  /* Desktop: plain nav row, no disclosure chrome. */
  nav[aria-label="Glavna navigacija"] {
    display: flex;
    align-items: center;
    gap: var(--space-xl);
  }

  nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-lg);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  nav a {
    color: var(--text-secondary);
    text-decoration: none;
    font-size: var(--text-body-sm-size);
  }

  nav a:hover {
    color: var(--text-accent);
  }

  .nav-disclosure summary {
    list-style: none;
  }

  .nav-disclosure summary::-webkit-details-marker {
    display: none;
  }

  /* Single Signature Shape mark, no open/close icon swap — it just turns
     180° in place on toggle (2026-09-05, owner-specified). Was previously
     the logo mark (two paths) cross-fading to an X, a mismatch from the
     Signature-Shape intent recorded in CLAUDE.md's 2026-09-04 session
     notes — corrected here to the actual signature-shape.svg path. */
  .menu-shape {
    transition: transform var(--motion-slow) var(--ease-emphasized);
  }

  .nav-disclosure[open] .menu-shape {
    transform: rotate(180deg);
  }

  /* <nav> used to live *inside* <details>, relying on the browser's native
     open/closed behavior to show/hide it. Found via a Playwright test
     failure (2026-09-04): a <nav> nested inside a <details> flex ancestor
     computes a 0 max-content width in this browser's flexbox intrinsic-
     sizing algorithm, regardless of the <details>'s own `display` value —
     confirmed by moving <nav> out from under <details> as a plain sibling,
     which fixed it immediately. <nav> is now a sibling of <details>, shown
     on mobile via the `[open] + nav` selector below instead of natively. */
  .nav-disclosure {
    display: inline-flex;
    align-items: center;
  }

  .cta-mobile {
    display: none;
  }

  @media (min-width: 768px) {
    .nav-disclosure {
      display: none;
    }

    /* Floating pill navbar — referenced from compatto.gr's shape (full
       rounded capsule, white surface), with an added shadow so it reads
       as lifted/floating above the page (compatto's own doesn't have
       one — this is a deliberate addition, per owner request). */
    .site-header {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      margin: var(--space-lg) var(--space-xl) 0;
      padding: var(--space-sm) var(--space-lg) var(--space-sm) var(--space-xl);
      background: var(--surface-1);
      border-bottom: none;
      border-radius: var(--radius-full);
      box-shadow: var(--shadow-2);
    }

    /* Logo left, nav links centered independently of the CTA, CTA pinned
       to the far right edge — three distinct zones instead of grouping
       the nav and CTA together on the right. */
    .logo {
      grid-column: 1;
      justify-self: start;
    }

    nav[aria-label="Glavna navigacija"] {
      grid-column: 2;
      justify-self: center;
    }

    .cta-desktop {
      grid-column: 3;
      justify-self: end;
    }
  }

  /* Mobile: logo + toggle in the bar, full nav panel opens below it. */
  @media (max-width: 767px) {
    .cta-desktop {
      display: none;
    }

    .nav-disclosure summary {
      position: relative;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 44px;
      height: 44px;
      color: var(--icon-primary);
      cursor: pointer;
      border-radius: var(--radius-2);
    }

    .nav-disclosure summary:focus-visible {
      outline: none;
      box-shadow: var(--focus-default);
    }

    .nav-disclosure[open] summary {
      position: absolute;
      top: var(--space-md);
      right: var(--container-padding);
    }

    nav[aria-label="Glavna navigacija"] {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      z-index: var(--z-dropdown);
      flex-direction: column;
      align-items: stretch;
      gap: var(--space-lg);
      padding: var(--space-lg) var(--container-padding) var(--space-xl);
      background: var(--surface-1);
      border-bottom: var(--border-1) solid var(--border-subtle);
      box-shadow: var(--shadow-2);
    }

    .nav-disclosure[open] + nav[aria-label="Glavna navigacija"] {
      display: flex;
    }

    nav ul {
      flex-direction: column;
      gap: var(--space-md);
    }

    .cta-mobile {
      display: inline-flex;
      justify-content: center;
    }
  }
</style>
