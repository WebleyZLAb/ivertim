---
const navItems = [
  { href: "/usluge", label: "Usluge" },
  { href: "/projekti", label: "Projekti" },
  { href: "/proces-saradnje", label: "Proces saradnje" },
  { href: "/blog", label: "Blog" },
];
---

<header class="site-header">
  <a class="logo" href="/" aria-label="Ivertim — početna">
    <img src="/images/logo-horizontal.svg" alt="Ivertim" width="140" height="21" />
  </a>

  <div class="nav-actions">
  <a class="cta cta-desktop" href="/kontakt">Razgovarajmo</a>

  <details class="nav-disclosure">
    <summary aria-label="Otvori meni">
      <svg class="icon-open" viewBox="0 0 174.79 168.95" width="22" height="22" fill="currentColor" aria-hidden="true">
        <path d="M101.53,160.33c-.29-12.65.69-24.16-.33-36.72-2.31-28.52-25.08-52.38-53.58-54.66-11.79-.94-22.45-.07-34.18-.33-1.97-.04-3.84-2.16-3.84-4.17V23.21c0-8.57,6.53-17.98,16.33-17.99l116.48-.05c15.5,0,25.49,13.34,25.47,27.79l-.13,109.78c-.02,12.78-10.46,21.09-22.56,21.05l-40.2-.12c-1.54,0-3.43-1.84-3.46-3.33Z" />
        <path d="M75.45,163.71l-50.37-.31c-8.97-.05-15.45-8.75-15.45-17l-.03-51.65c0-1.33,2.55-3.57,3.77-3.52,9.75.37,18.45-.61,28.14.4,19.76,2.05,35.54,19.13,37.11,38.91.81,10.28.11,19.44.34,29.82.03,1.39-2.04,3.36-3.5,3.35Z" />
      </svg>
      <svg class="icon-close" viewBox="0 0 24 24" width="22" height="22" fill="none" aria-hidden="true">
        <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
      </svg>
    </summary>
  </details>

  <nav aria-label="Glavna navigacija">
    <ul>
      {
        navItems.map((item) => (
          <li>
            <a href={item.href}>{item.label}</a>
          </li>
        ))
      }
    </ul>
    <a class="cta cta-mobile" href="/kontakt">Razgovarajmo</a>
  </nav>
  </div>
</header>

<script>
  const disclosure = document.querySelector<HTMLDetailsElement>(".nav-disclosure");
  const summary = disclosure?.querySelector("summary");

  disclosure?.addEventListener("toggle", () => {
    summary?.setAttribute("aria-label", disclosure.open ? "Zatvori meni" : "Otvori meni");
  });
</script>

<style>
  .site-header {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    padding: var(--space-md) var(--container-padding);
    border-bottom: var(--border-1) solid var(--border-subtle);
    background: var(--bg-primary);
  }

  /* Groups the CTA, disclosure toggle and nav as one flex item so
     `.site-header`'s justify-content: space-between only splits [logo] from
     [everything else], instead of spacing 3 separate top-level items evenly
     (which put the CTA in the middle of the header instead of next to nav). */
  .nav-actions {
    display: flex;
    align-items: center;
    gap: var(--space-xl);
  }

  .logo {
    display: inline-flex;
    align-items: center;
    line-height: 0;
  }

  .logo img {
    height: 22px;
    width: auto;
  }

  .cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-sm) var(--space-lg);
    background: var(--action-primary);
    color: var(--action-primary-text);
    border-radius: var(--radius-2);
    text-decoration: none;
    font-size: var(--text-label-md-size);
    font-weight: var(--text-label-md-weight);
    transition: background var(--motion-fast) var(--ease-out);
  }

  .cta:hover {
    background: var(--action-primary-hover);
    color: var(--action-primary-text);
  }

  .cta:active {
    background: var(--action-primary-active);
  }

  .cta:focus-visible {
    outline: none;
    box-shadow: var(--focus-default);
  }

  /* Desktop: plain nav row, no disclosure chrome. */
  nav[aria-label="Glavna navigacija"] {
    display: flex;
    align-items: center;
    gap: var(--space-xl);
  }

  nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-lg);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  nav a {
    color: var(--text-secondary);
    text-decoration: none;
    font-size: var(--text-body-sm-size);
  }

  nav a:hover {
    color: var(--text-accent);
  }

  .nav-disclosure summary {
    list-style: none;
  }

  .nav-disclosure summary::-webkit-details-marker {
    display: none;
  }

  .icon-open,
  .icon-close {
    position: absolute;
    inset: 0;
    margin: auto;
    transition:
      opacity var(--motion-fast) var(--ease-out),
      transform var(--motion-fast) var(--ease-out);
  }

  .icon-close {
    opacity: 0;
    transform: rotate(-45deg) scale(0.6);
  }

  .nav-disclosure[open] .icon-open {
    opacity: 0;
    transform: rotate(45deg) scale(0.6);
  }

  .nav-disclosure[open] .icon-close {
    opacity: 1;
    transform: rotate(0deg) scale(1);
  }

  /* <nav> used to live *inside* <details>, relying on the browser's native
     open/closed behavior to show/hide it. Found via a Playwright test
     failure (2026-09-04): a <nav> nested inside a <details> flex ancestor
     computes a 0 max-content width in this browser's flexbox intrinsic-
     sizing algorithm, regardless of the <details>'s own `display` value —
     confirmed by moving <nav> out from under <details> as a plain sibling,
     which fixed it immediately. <nav> is now a sibling of <details>, shown
     on mobile via the `[open] + nav` selector below instead of natively. */
  .nav-disclosure {
    display: inline-flex;
    align-items: center;
  }

  .cta-mobile {
    display: none;
  }

  @media (min-width: 768px) {
    .nav-disclosure {
      display: none;
    }

    /* Floating pill navbar — referenced from compatto.gr's shape (full
       rounded capsule, white surface), with an added shadow so it reads
       as lifted/floating above the page (compatto's own doesn't have
       one — this is a deliberate addition, per owner request). */
    .site-header {
      margin: var(--space-lg) var(--space-xl) 0;
      padding: var(--space-sm) var(--space-lg) var(--space-sm) var(--space-xl);
      background: var(--surface-1);
      border-bottom: none;
      border-radius: var(--radius-full);
      box-shadow: var(--shadow-2);
    }
  }

  /* Mobile: logo + toggle in the bar, full nav panel opens below it. */
  @media (max-width: 767px) {
    .cta-desktop {
      display: none;
    }

    .nav-disclosure summary {
      position: relative;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 44px;
      height: 44px;
      color: var(--icon-primary);
      cursor: pointer;
      border-radius: var(--radius-2);
    }

    .nav-disclosure summary:focus-visible {
      outline: none;
      box-shadow: var(--focus-default);
    }

    .nav-disclosure[open] summary {
      position: absolute;
      top: var(--space-md);
      right: var(--container-padding);
    }

    nav[aria-label="Glavna navigacija"] {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      z-index: var(--z-dropdown);
      flex-direction: column;
      align-items: stretch;
      gap: var(--space-lg);
      padding: var(--space-lg) var(--container-padding) var(--space-xl);
      background: var(--surface-1);
      border-bottom: var(--border-1) solid var(--border-subtle);
      box-shadow: var(--shadow-2);
    }

    .nav-disclosure[open] + nav[aria-label="Glavna navigacija"] {
      display: flex;
    }

    nav ul {
      flex-direction: column;
      gap: var(--space-md);
    }

    .cta-mobile {
      display: inline-flex;
      justify-content: center;
    }
  }
</style>
