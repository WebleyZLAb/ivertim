---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <!-- Whole footer wrapped as one rounded card (owner's ask, 2026-09-13,
       compatto reference), not just a top border — measured compatto's
       own footer card live: background distinct from the page, radius
       ~24px (this site's own --radius-4/16px reused, not a new value),
       inset from the viewport edges rather than edge-to-edge. Both the
       main content row and the copyright bar below sit inside this same
       card, matching what compatto's own DOM does. -->
  <div class="footer-card">
  <div class="footer-main">
    <div class="footer-brand">
      <a class="footer-logo" href="/" aria-label="Ivertim — početna">
        <img src="/images/logo-horizontal.svg" alt="Ivertim" width="140" height="21" />
      </a>
      <p class="tagline">Kompetentnost kojoj vjeruješ.</p>

      <!-- Newsletter — owner's ask, 2026-09-13 (compatto.gr reference).
           Progressively enhanced: works as a plain POST to /api/newsletter
           with no JS (redirects back here with ?status=..., see that
           file's own comment on why it can't render a styled confirmation
           on a static page without JS); the script below intercepts it for
           a real inline message instead. Only needs RESEND_API_KEY (same
           key the contact form already uses) — Resend's Contacts API is
           global, no Audience/ID to create (see src/lib/email.ts's
           subscribeToNewsletter). Stacked full-width fields + a real
           consent checkbox (owner's ask, same day, second pass matching
           compatto's own layout more closely) instead of the first
           version's inline input+button row. -->
      <form class="newsletter-form" method="POST" action="/api/newsletter" data-newsletter-form>
        <p class="label">Newsletter</p>
        <p class="newsletter-copy">Povremeni savjeti o obradi materijala i namještaju po mjeri — bez spama.</p>

        <label class="visually-hidden" for="newsletter-email">Email adresa</label>
        <input
          class="newsletter-input"
          id="newsletter-email"
          type="email"
          name="email"
          placeholder="Vaš email"
          autocomplete="email"
          required
        />

        <div class="newsletter-consent">
          <input id="newsletter-consent" type="checkbox" name="consent" required />
          <label for="newsletter-consent">Slažem se sa <a href="/politika-privatnosti">Politikom privatnosti</a>.</label>
        </div>

        <!-- Same visual treatment as the site's primary .cta buttons
             (fill fades via opacity, border/text invert to brand brown on
             hover, motion-slower, no lift) — owner's ask, 2026-09-13:
             "da izgleda kao primary sa našim hoverom". -->
        <button class="newsletter-submit" type="submit">Prijavi se</button>

        <!-- Honeypot — same technique as the contact form, real users never see/fill this. -->
        <input class="hp-field" type="text" name="company" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <input type="hidden" name="referer" value="" data-newsletter-referer />
        <p class="newsletter-note" data-newsletter-message>Odjava u jednom kliku, kad god poželite.</p>
      </form>
    </div>

    <!-- Owner's ask, 2026-09-13: keep this cluster visually separate from
         the brand column (compatto's own footer has a much wider gap
         before its Menu/Legal/Contact group than between those three
         themselves) — a plain 4-column grid can't have two different gap
         sizes, so the three link columns are grouped under their own
         nested grid instead. -->
    <div class="footer-links">
      <nav aria-label="Footer navigacija">
        <p class="label">Stranice</p>
        <ul>
          <li><a href="/usluge">Usluge</a></li>
          <li><a href="/projekti">Projekti</a></li>
          <li><a href="/proces-saradnje">Proces saradnje</a></li>
          <li><a href="/blog">Blog</a></li>
          <li><a href="/kontakt">Kontakt</a></li>
        </ul>
      </nav>

      <!-- Draft pages (owner's ask, 2026-09-13) — see politika-privatnosti.astro's
           own header comment: real content, not placeholders, but flagged
           there as pending a proper legal review before final launch. -->
      <nav aria-label="Pravna navigacija">
        <p class="label">Pravno</p>
        <ul>
          <li><a href="/politika-privatnosti">Politika privatnosti</a></li>
          <li><a href="/uslovi-koristenja">Uslovi korištenja</a></li>
          <li><a href="/kolacici">Kolačići</a></li>
        </ul>
      </nav>

      <div class="footer-contact-block">
        <p class="label">Kontakt</p>
        <!-- <address> — a single semantic block for the business's contact
             facts (owner's ask, 2026-09-13: "u jedan div koji će biti
             adresa... google to voli"). Each row is icon+link now
             (owner's ask, second pass, compatto reference) — icons are
             Feather's map-pin/phone/mail (MIT, verified source, not
             hand-drawn) recolored via `currentColor` like every other
             icon on this site. Same real, confirmed facts already used
             in the LocalBusiness JSON-LD on /kontakt. -->
        <address class="footer-address">
          <a
            class="address-row"
            href="https://www.google.com/maps/search/?api=1&query=Svale+bb%2C+79101+Prijedor"
            target="_blank"
            rel="noopener noreferrer"
          >
            <svg class="address-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
              <circle cx="12" cy="10" r="3"></circle>
            </svg>
            <span>Svale bb, 79101 Prijedor</span>
          </a>
          <a class="address-row" href="tel:+38765748943">
            <svg class="address-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
            </svg>
            <span>+387 65 748 943</span>
