        </ul>
      </div>
    </div>
  </div>

  <!-- Short, centered copyright (owner's ask, 2026-09-13, replacing the
       previous left-aligned line that spelled out the full legal entity
       name — that fuller name still lives on /kontakt's own LocalBusiness
       JSON-LD and legal pages, so it isn't lost, just not repeated here). -->
  <div class="footer-legal">
    <p>&copy; {year} Ivertim — Sva prava zadržana.</p>
  </div>
  </div>
</footer>

<script>
  const form = document.querySelector<HTMLFormElement>("[data-newsletter-form]");
  const message = document.querySelector<HTMLElement>("[data-newsletter-message]");
  const refererField = document.querySelector<HTMLInputElement>("[data-newsletter-referer]");
  const defaultNote = message?.textContent ?? "";

  if (refererField) refererField.value = window.location.pathname;

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!message) return;

    const submitButton = form.querySelector<HTMLButtonElement>(".newsletter-submit");
    const emailInput = form.querySelector<HTMLInputElement>("#newsletter-email");
    submitButton?.setAttribute("disabled", "true");

    try {
      const response = await fetch(form.action, {
        method: "POST",
        headers: { Accept: "application/json" },
        body: new FormData(form),
      });
      const data = await response.json();

      if (data.ok) {
        message.textContent = "Hvala! Prijava je uspješna.";
        message.classList.remove("is-error");
        message.classList.add("is-success");
        if (emailInput) emailInput.value = "";
        form.reset();
      } else {
        message.textContent =
          data.reason === "invalid-email" ? "Unesite ispravnu email adresu." : "Nešto nije uspjelo. Pokušajte ponovo.";
        message.classList.remove("is-success");
        message.classList.add("is-error");
      }
    } catch {
      message.textContent = "Nešto nije uspjelo. Pokušajte ponovo.";
      message.classList.remove("is-success");
      message.classList.add("is-error");
    } finally {
      submitButton?.removeAttribute("disabled");
      window.setTimeout(() => {
        message.textContent = defaultNote;
        message.classList.remove("is-success", "is-error");
      }, 6000);
    }
  });
</script>

<style>
  /* Outer wrapper just provides the inset (container-padding) and top
     spacing — no background/border of its own now, that lives on
     .footer-card below so the page's own background shows around the
     card's edges instead of the footer bleeding edge-to-edge. */
  .site-footer {
    padding: 0 var(--container-padding) var(--container-padding);
    margin-top: var(--section-gap);
  }

  .footer-card {
    max-width: var(--container-xl);
    margin: 0 auto;
    padding: var(--space-2xl);
    border-radius: var(--radius-4);
    background: var(--bg-secondary);
  }

  .footer-main {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-2xl);
    max-width: var(--container-xl);
    margin: 0 auto;
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: var(--space-sm);
  }

  .footer-logo {
    display: block;
    line-height: 0;
  }

  /* Bigger than the header's own 140px logo, but capped — NOT stretched
     to the full (now wide, ~50%) brand column — owner's ask, 2026-09-13,
     fourth pass: compatto's own logo reads as a modest standalone mark
     sitting inside a much wider column, with real unused space beside it
     (see .footer-main's own comment on why the column itself stays wide
     while its content doesn't). */
  .footer-logo img {
    width: 100%;
    max-width: 220px;
    height: auto;
  }

  /* Bumped up a step (owner's ask, 2026-09-13) — was --text-body-sm,
     read too quiet next to the now much bigger logo above it. */
  .tagline {
    color: var(--text-secondary);
    font-size: var(--text-body-md-size);
  }

  .label {
    font-size: var(--text-overline-size);
    font-weight: var(--text-overline-weight);
    letter-spacing: var(--text-overline-tracking);
    text-transform: uppercase;
    /* text-secondary, not text-tertiary — at 12px, text-tertiary (neutral-500) only
       reaches ~3.1:1 contrast on this background, below WCAG AA's 4.5:1 for normal text. */
    color: var(--text-secondary);
    margin-bottom: var(--space-sm);
  }

  /* ---------- Newsletter ----------
     No flex `gap` here (unlike .footer-brand above) — deliberately, so
     each child's own margin controls its own spacing instead of a single
     uniform value applying everywhere. That's what makes the tight
     label→copy pairing below possible without also cramping every other
     gap in the form. */
  /* Capped, not stretched to the (now wide, ~50%) brand column — same
     reasoning as .footer-logo img above: the leftover space to the right
     of this cap, still inside the same grid column, is what actually
     produces the "gap" before Menu/Legal/Contact start. */
  .newsletter-form {
    margin-top: var(--space-md);
    max-width: 380px;
    display: flex;
    flex-direction: column;
  }

  /* Sits close under its own "NEWSLETTER" label (owner's ask, 2026-09-13:
     the two should read as one group) — overrides the shared .label's
     own margin-bottom (space-sm) down to space-1. */
  .newsletter-form .label {
    margin-bottom: var(--space-1);
  }

  .newsletter-copy {
    color: var(--text-secondary);
    font-size: var(--text-body-sm-size);
    line-height: var(--text-body-sm-leading);
    margin-bottom: var(--space-md);
  }

  .newsletter-input {
    width: 100%;
    padding: var(--space-sm) var(--space-md);
    border: var(--border-1) solid var(--border-default);
    border-radius: var(--radius-2);
    background: var(--surface-1);
    color: var(--text-primary);
    font-size: var(--text-body-sm-size);
    font-family: inherit;
  }

  .newsletter-input:focus-visible {
    outline: none;
    box-shadow: var(--focus-default);
  }

  .newsletter-consent {
    display: flex;
    align-items: flex-start;
    gap: var(--space-xs);
    margin-top: var(--space-sm);
  }

  .newsletter-consent input {
    margin-top: 3px;
    flex-shrink: 0;
    accent-color: var(--action-primary);
  }

  .newsletter-consent label {
    color: var(--text-secondary);
    font-size: var(--text-caption-size);
    line-height: var(--text-body-sm-leading);
  }

  .newsletter-consent a {
    color: var(--text-accent);
  }

  .newsletter-consent a:hover {
    color: var(--link-hover);
  }

  /* Same inversion/opacity-fade pattern as every primary .cta button
     site-wide — see Header.astro's .cta for the full rationale on why
     it's opacity, not a background swap, and why there's no lift/shadow.
     Duplicated here rather than shared, matching how every other file
     with a primary-style button already does it. */
  .newsletter-submit {
    position: relative;
    z-index: 0;
    overflow: hidden;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    margin-top: var(--space-sm);
    padding: var(--space-sm) var(--space-lg);
    border: var(--border-1) solid transparent;
    border-radius: var(--radius-2);
    background: none;
    color: var(--action-primary-text);
    font-size: var(--text-body-sm-size);
    font-weight: var(--text-label-md-weight);
    font-family: inherit;
    cursor: pointer;
    transition: border-color var(--motion-slower) var(--ease-out), color var(--motion-slower) var(--ease-out);
  }

  .newsletter-submit::before {
    content: "";
    position: absolute;
    z-index: -1;
    inset: 0;
    border-radius: inherit;
    background: var(--gradient-button);
    opacity: 1;
    transition: opacity var(--motion-slower) var(--ease-out);
    -webkit-mask-image: linear-gradient(#000 0 0), url("/images/signature-shape.svg");
    -webkit-mask-repeat: no-repeat, no-repeat;
    -webkit-mask-position: 0 0, 0 calc(100% + 4px);
    -webkit-mask-size: 100% 100%, auto 62%;
    -webkit-mask-composite: xor;
    mask-image: linear-gradient(#000 0 0), url("/images/signature-shape.svg");
    mask-repeat: no-repeat, no-repeat;
    mask-position: 0 0, 0 calc(100% + 4px);
    mask-size: 100% 100%, auto 62%;
    mask-composite: exclude;
  }

  .newsletter-submit:hover::before,
  .newsletter-submit:active::before {
    opacity: 0;
  }

  .newsletter-submit:hover {
    border-color: var(--action-primary-hover);
    color: var(--action-primary-hover);
  }

  .newsletter-submit:active {
    border-color: var(--action-primary-active);
    color: var(--action-primary-active);
  }

  .newsletter-submit:disabled {
    opacity: 0.6;
    cursor: default;
  }

  .newsletter-submit:focus-visible {
    outline: none;
    box-shadow: var(--focus-default);
  }

  .newsletter-note {
    margin-top: var(--space-sm);
    color: var(--text-tertiary);
    font-size: var(--text-caption-size);
  }

  .newsletter-note.is-success {
    color: var(--success-text);
  }

  .newsletter-note.is-error {
    color: var(--error-text);
  }

  /* Honeypot — visually and semantically hidden, but still present/
     fillable by bots that don't respect display:none. */
  .hp-field {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
